#!/usr/bin/env python3
"""
Dedicated Cleanup & Restoration CLI for Cursor Theme Manager.
Invokes cleanup_engine functions with strict arguments and bounded output.
"""

import sys
import os
import argparse
import json

# Add scripts directory to module search path
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

import cleanup_engine
from runtime_safety import emit_bounded_json


def main():
    parser = argparse.ArgumentParser(description="Cursor Theme Manager Cleanup & Restoration Helper")
    subparsers = parser.add_subparsers(dest="action", required=True)

    # snapshot-original-state
    subparsers.add_parser("snapshot-original-state")

    # restore-original-state
    subparsers.add_parser("restore-original-state")

    # unregister-app
    subparsers.add_parser("unregister-app")

    # deactivate
    subparsers.add_parser("deactivate")

    # purge
    subparsers.add_parser("purge")

    # on-destroy
    p_destroy = subparsers.add_parser("on-destroy")
    p_destroy.add_argument("--plugin-dir", default="", help="Plugin checkout directory path")

    # audit-installation
    subparsers.add_parser("audit-installation")

    # install-integration
    p_inst = subparsers.add_parser("install-integration")
    p_inst.add_argument("--source", required=True, help="Plugin source root directory")

    # remove-integration
    subparsers.add_parser("remove-integration")

    args = parser.parse_args()

    if args.action == "snapshot-original-state":
        res = cleanup_engine.snapshot_original_state()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)
    elif args.action == "restore-original-state":
        res = cleanup_engine.restore_original_state()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)
    elif args.action == "unregister-app":
        res = cleanup_engine.unregister_app()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)
    elif args.action == "deactivate":
        res = cleanup_engine.deactivate()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)
    elif args.action == "purge":
        res = cleanup_engine.purge()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)
    elif args.action == "on-destroy":
        res = cleanup_engine.on_destroy(args.plugin_dir)
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)
    elif args.action == "audit-installation":
        res = cleanup_engine.audit_installation()
        emit_bounded_json(res, exit_code=0)
    elif args.action == "install-integration":
        res = cleanup_engine.install_integration(args.source)
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)
    elif args.action == "remove-integration":
        res = cleanup_engine.remove_integration()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)


if __name__ == "__main__":
    main()
