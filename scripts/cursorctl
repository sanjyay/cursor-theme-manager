#!/usr/bin/python3
"""
Unified CLI & Dispatcher for Cursor Theme Manager.
Supervises all actions with bounded execution, process-group isolation,
secure descriptor-held state operations, and transactional integration.
"""

import sys
import os
import re
import json
import shutil
import hashlib
import tempfile
import argparse
from pathlib import Path
from typing import List, Dict, Any, Optional

# Add script dir to path
SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from runtime_safety import (
    run_bounded, resolve_system_executable, sanitize_text, emit_bounded_json,
    TIMEOUT_DISCOVERY, TIMEOUT_APPLY, TIMEOUT_CONVERT, TIMEOUT_OPEN_FOLDER,
    TIMEOUT_STATE, LIMIT_STDOUT_DEFAULT, LIMIT_STDOUT_MEDIUM, LIMIT_STDOUT_LARGE,
    LIMIT_STDOUT_SMALL, LIMIT_STDERR_DEFAULT, MAX_DISCOVERED_THEMES,
    MAX_LEN_THEME_ID, MAX_LEN_DISPLAY_NAME, MAX_LEN_PATH, MAX_LEN_SUBTITLE,
    MAX_LEN_LICENSE
)
import secure_state
import integration_manager
import cursor_theming
import file_browser

NAME_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._+ -]{0,127}$')
_REQUEST_PLUGIN_FINGERPRINT: Optional[str] = None


def valid_name(name: str) -> bool:
    if not name or ".." in name:
        return False
    return bool(NAME_RE.match(name))


def read_ini_key(file_path: Path, key: str, max_bytes: int = 32768) -> str:
    """Safely reads a single key from an INI/manifest file without symlink escapes."""
    if not file_path.is_file() or file_path.is_symlink():
        return ""
    try:
        if file_path.stat().st_size > max_bytes:
            return ""
        content = file_path.read_text(encoding="utf-8", errors="ignore")
        pattern = re.compile(rf'^\s*{re.escape(key)}\s*=\s*(.+)$', re.MULTILINE)
        m = pattern.search(content)
        if m:
            val = m.group(1).split("#")[0].split(";")[0].strip()
            val = val.strip("'\"")
            return val
    except Exception:
        pass
    return ""


def has_xcursor(theme_dir: Path) -> bool:
    cursors = theme_dir / "cursors"
    if not cursors.is_dir():
        return False
    for candidate in ("left_ptr", "default", "arrow", "pointer", "top_left_arrow"):
        cand_path = cursors / candidate
        if cand_path.is_file():
            return True
    return False


def has_hyprcursor(theme_dir: Path) -> bool:
    manifest_hl = theme_dir / "manifest.hl"
    manifest_toml = theme_dir / "manifest.toml"
    if not manifest_hl.is_file() and not manifest_toml.is_file():
        return False
    cursors_dir = read_ini_key(manifest_hl, "cursors_directory") or read_ini_key(manifest_toml, "cursors_directory") or "hyprcursors"
    if not valid_name(cursors_dir):
        return False
    return (theme_dir / cursors_dir).is_dir()


def get_preview_path(theme_dir: Path) -> str:
    base = theme_dir.name
    home = Path(os.environ.get("HOME", os.path.expanduser("~")))
    cache_dir = Path(os.environ.get("XDG_CACHE_HOME", str(home / ".cache"))) / "omarchy-cursor-switcher" / "previews"
    preview_png = cache_dir / f"{base}.png"
    if preview_png.is_file():
        return str(preview_png)

    cursors_dir = theme_dir / "cursors"
    if not cursors_dir.is_dir():
        return ""

    cur_path = None
    for cand in ("left_ptr", "default", "arrow", "pointer", "top_left_arrow"):
        cand_file = cursors_dir / cand
        if cand_file.is_file():
            cur_path = cand_file
            break

    if cur_path and resolve_system_executable("xcur2png"):
        cache_dir.mkdir(parents=True, exist_ok=True)
        temp_dir = Path(tempfile.mkdtemp(prefix=".preview_tmp_"))
        try:
            res = run_bounded(["xcur2png", str(cur_path)], cwd=str(temp_dir), timeout=2.0, stdout_limit=LIMIT_STDOUT_SMALL)
            if res.ok:
                pngs = sorted(temp_dir.glob("*.png"), key=lambda p: p.stat().st_size, reverse=True)
                if pngs:
                    best_png = pngs[0]
                    if resolve_system_executable("magick"):
                        run_bounded(["magick", str(best_png), "-resize", "64x64", str(preview_png)], timeout=2.0)
                    else:
                        shutil.copy2(best_png, preview_png)
                    if preview_png.is_file():
                        return str(preview_png)
        except Exception:
            pass
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)
    return ""


# ==============================================================================
# DISCOVERY
# ==============================================================================

def run_discover():
    home = Path(os.environ.get("HOME", os.path.expanduser("~")))
    data_home = Path(os.environ.get("XDG_DATA_HOME", str(home / ".local" / "share")))
    user_icons = data_home / "icons"
    data_home = Path(os.environ.get("XDG_DATA_HOME", str(home / ".local" / "share")))
    roots = [data_home / "icons", home / ".icons"]
    sys_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    for d in sys_dirs:
        if d.strip():
            roots.append(Path(d.strip()) / "icons")

    discovered_themes = []
    seen_ids = set()

    for root in roots:
        if not root.is_dir():
            continue
        is_sys_root = (root != data_home / "icons" and root != home / ".icons")

        try:
            entries = list(root.iterdir())
        except OSError:
            continue

        for theme_dir in entries:
            if len(discovered_themes) >= MAX_DISCOVERED_THEMES:
                break
            if not theme_dir.is_dir() or theme_dir.is_symlink():
                continue

            base = theme_dir.name
            if not valid_name(base):
                continue

            # Skip internal generated conversion themes and staging artifacts
            gen_marker = theme_dir / ".cursor-theme-manager-generated"
            conv_marker = theme_dir / ".omarchy-cursor-switcher-converted"
            if (
                base.startswith("CursorSwitcher-XCursor-") or
                base.startswith("CursorSwitcher-Themed-") or
                base.startswith("CursorSwitcher-Preview-") or
                base.startswith("extracted_") or
                base.startswith(".convert-") or
                base.startswith(".cs-") or
                base.startswith(".install-stage-") or
                gen_marker.is_file() or
                conv_marker.is_file()
            ):
                continue

            hypr = ""
            xcursor = ""
            formats = []
            display = ""
            is_imported = False
            source_type = "user"
            subtitle = ""

            if has_hyprcursor(theme_dir):
                mname = read_ini_key(theme_dir / "manifest.hl", "name") or read_ini_key(theme_dir / "manifest.toml", "name") or base
                if mname == "Extracted Theme" or not valid_name(mname):
                    mname = base
                hypr = mname
                display = hypr
                formats.append("hyprcursor")

            if has_xcursor(theme_dir):
                xcursor = base
                index_name = read_ini_key(theme_dir / "index.theme", "Name") or base
                if valid_name(index_name):
                    display = index_name or display
                else:
                    display = display or base
                formats.append("xcursor")

            if not formats:
                continue

            path_str = sanitize_text(str(theme_dir.resolve()), max_len=MAX_LEN_PATH)
            marker = theme_dir / ".omarchy-cursor-switcher-imported"
            import_license = "Unknown"

            if marker.is_file():
                is_imported = True
                source_type = "imported"
                try:
                    meta = json.loads(marker.read_text(encoding="utf-8"))
                    imp_name = meta.get("displayName", "")
                    imp_lic = meta.get("license", "")
                    if imp_name:
                        display = imp_name
                    if imp_lic:
                        import_license = imp_lic
                except Exception:
                    pass
                subtitle = f"Imported • {import_license}" if import_license and import_license != "Unknown" else "Imported"
            elif is_sys_root:
                source_type = "system"
                idx_comment = read_ini_key(theme_dir / "index.theme", "Comment")
                subtitle = idx_comment if idx_comment else "System"
            else:
                source_type = "user"
                idx_comment = read_ini_key(theme_dir / "index.theme", "Comment")
                subtitle = idx_comment if idx_comment else "User"

            hypr_val = hypr if (hypr and hypr != "-") else "-"
            xcur_val = xcursor if (xcursor and xcursor != "-") else "-"

            runtime_theme = hypr_val if hypr_val != "-" else xcur_val
            runtime_prepared = (hypr_val != "-")
            if not runtime_prepared and xcur_val != "-":
                for cand in user_icons.iterdir():
                    if cand.is_dir() and cand.name.startswith(f"CursorSwitcher-XCursor-{base}-"):
                        if (cand / "manifest.hl").is_file() and (cand / ".cursor-theme-manager-generated").is_file():
                            runtime_theme = cand.name
                            hypr_val = cand.name
                            runtime_prepared = True
                            if "hyprcursor" not in formats:
                                formats.append("hyprcursor")
                            break
            if runtime_theme == "-":
                runtime_theme = base

            theme_preview = get_preview_path(theme_dir)

            theme_record = {
                "id": sanitize_text(base, max_len=MAX_LEN_THEME_ID),
                "displayName": sanitize_text(display, max_len=MAX_LEN_DISPLAY_NAME),
                "family": sanitize_text(display, max_len=MAX_LEN_DISPLAY_NAME),
                "subtitle": sanitize_text(subtitle, max_len=MAX_LEN_SUBTITLE),
                "hyprcursor": sanitize_text(hypr_val, max_len=MAX_LEN_THEME_ID),
                "xcursor": sanitize_text(xcur_val, max_len=MAX_LEN_THEME_ID),
                "runtimeTheme": sanitize_text(runtime_theme, max_len=MAX_LEN_THEME_ID),
                "runtimePrepared": bool(runtime_prepared),
                "path": path_str,
                "formats": formats,
                "imported": is_imported,
                "sourceType": source_type,
                "license": sanitize_text(import_license, max_len=MAX_LEN_LICENSE),
                "previewPath": sanitize_text(theme_preview, max_len=MAX_LEN_PATH)
            }
            discovered_themes.append(theme_record)

    # Current XCursor from gsettings
    current_xcursor = ""
    res = run_bounded(["gsettings", "get", "org.gnome.desktop.interface", "cursor-theme"], timeout=2.0, stdout_limit=LIMIT_STDOUT_SMALL)
    if res.ok and res.stdout.strip():
        current_xcursor = res.stdout.strip().strip("'\"")

    if current_xcursor == "default":
        def_theme = Path("/usr/share/icons/default/index.theme")
        if def_theme.is_file() and not def_theme.is_symlink():
            inh = read_ini_key(def_theme, "Inherits")
            if valid_name(inh):
                current_xcursor = inh

    int_status = integration_manager.get_status()
    emit_bounded_json({
        "themes": discovered_themes,
        "currentXcursor": sanitize_text(current_xcursor, max_len=MAX_LEN_THEME_ID),
        "integrationEnabled": int_status["enabled"],
        "integrationPromptSeen": int_status["promptSeen"],
        "trustedTools": {
            "hyprctl": resolve_system_executable("hyprctl") or ""
        }
    }, max_bytes=LIMIT_STDOUT_LARGE)


# ==============================================================================
# ENSURE HYPRCURSOR (CONVERSION)
# ==============================================================================

def run_ensure_hyprcursor(hypr: str, xcursor: str, theme_path: str = "") -> str:
    if hypr not in ("", "-") and not valid_name(hypr):
        sys.stderr.write("cursorctl: invalid Hyprcursor theme name\n")
        sys.exit(1)
    if xcursor not in ("", "-") and not valid_name(xcursor):
        sys.stderr.write("cursorctl: invalid XCursor theme name\n")
        sys.exit(1)

    home = Path(os.environ.get("HOME", os.path.expanduser("~")))
    data_home = Path(os.environ.get("XDG_DATA_HOME", str(home / ".local" / "share")))
    user_icons = data_home / "icons"

    # 1. Native Hyprcursor check
    if hypr and hypr != "-":
        check_roots = [user_icons, home / ".icons"]
        sys_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
        for d in sys_dirs:
            if d.strip():
                check_roots.append(Path(d.strip()) / "icons")
        for r in check_roots:
            if not r.is_dir():
                continue
            for d in r.iterdir():
                if d.is_dir() and has_hyprcursor(d):
                    mname = read_ini_key(d / "manifest.hl", "name") or read_ini_key(d / "manifest.toml", "name") or d.name
                    if mname == hypr or d.name == hypr:
                        return hypr

    if not xcursor or xcursor == "-":
        sys.stderr.write("cursorctl: no cursor theme specified\n")
        sys.exit(1)

    # 2. Locate XCursor directory
    xdir = None
    if theme_path and (Path(theme_path) / "cursors").is_dir():
        requested = Path(theme_path).resolve()
        allowed_roots = [user_icons.resolve(), (home / ".icons").resolve()]
        for d in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":"):
            if d.strip():
                allowed_roots.append((Path(d.strip()) / "icons").resolve())
        if any(requested != root and root in requested.parents for root in allowed_roots):
            xdir = requested
        else:
            sys.stderr.write("cursorctl: theme path is outside trusted icon directories\n")
            sys.exit(1)
    else:
        roots = [user_icons, home / ".icons"]
        sys_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
        for d in sys_dirs:
            if d.strip():
                roots.append(Path(d.strip()) / "icons")
        for r in roots:
            cand = r / xcursor
            if (cand / "cursors").is_dir():
                xdir = cand
                break

    if not xdir or not (xdir / "cursors").is_dir():
        sys.stderr.write(f"cursorctl: XCursor directory not found for theme '{xcursor}'\n")
        sys.exit(1)

    # 3. Compute content hash of actual cursor files
    hasher = hashlib.sha256()
    if (xdir / "index.theme").is_file():
        hasher.update(b"index.theme\n")
        try: hasher.update((xdir / "index.theme").read_bytes())
        except Exception: pass
    cursors_dir = xdir / "cursors"
    if cursors_dir.is_dir():
        for root, _, files in os.walk(cursors_dir):
            for f in sorted(files):
                fp = Path(root) / f
                hasher.update(str(fp.relative_to(cursors_dir)).encode("utf-8"))
                try:
                    hasher.update(fp.read_bytes())
                except Exception:
                    pass
    hash_short = hasher.hexdigest()[:12]
    converted_name = f"CursorSwitcher-XCursor-{xcursor}-{hash_short}"
    target_dir = user_icons / converted_name

    if (target_dir / "manifest.hl").is_file() and (target_dir / "hyprcursors").is_dir():
        return converted_name

    if not resolve_system_executable("hyprcursor-util"):
        sys.stderr.write(f"cursorctl: hyprcursor-util is required to convert XCursor theme '{xcursor}'\n")
        sys.exit(1)

    temp_dir = Path(tempfile.mkdtemp(prefix=".cs-convert-"))
    clean_source = temp_dir / "clean_source"
    extracted_dir = temp_dir / "extracted"
    created_dir = temp_dir / "created"

    try:
        (clean_source / "cursors").mkdir(parents=True)
        extracted_dir.mkdir(parents=True)
        created_dir.mkdir(parents=True)
        user_icons.mkdir(parents=True, exist_ok=True)

        if (xdir / "index.theme").is_file():
            shutil.copy2(xdir / "index.theme", clean_source / "index.theme")

        for item in (xdir / "cursors").iterdir():
            if item.name.endswith(".cur") or item.name.endswith(".ani"):
                continue
            if item.is_symlink():
                target = os.readlink(item)
                if not target.endswith(".cur") and not target.endswith(".ani"):
                    try:
                        os.symlink(target, clean_source / "cursors" / item.name)
                    except OSError:
                        pass
            elif item.is_file():
                shutil.copy2(item, clean_source / "cursors" / item.name)

        # Run hyprcursor-util extract with run_bounded
        res = run_bounded(
            ["hyprcursor-util", "--extract", str(clean_source), "--output", str(extracted_dir)],
            timeout=TIMEOUT_CONVERT, stdout_limit=LIMIT_STDOUT_MEDIUM, stderr_limit=LIMIT_STDERR_DEFAULT
        )
        if not res.ok:
            sys.stderr.write(f"cursorctl: failed to extract XCursor theme '{xcursor}': {res.stderr}\n")
            sys.exit(1)

        extracted_theme = None
        for d in extracted_dir.iterdir():
            if d.is_dir() and d.name.startswith("extracted_"):
                extracted_theme = d
                break
        if not extracted_theme:
            sys.stderr.write(f"cursorctl: hyprcursor-util extract produced no output for '{xcursor}'\n")
            sys.exit(1)

        manifest_content = (
            f"name = {converted_name}\n"
            f"description = Automatically converted from {xcursor} by Cursor Theme Manager\n"
            f"version = 1.0\n"
            f"cursors_directory = hyprcursors\n"
        )
        (extracted_theme / "manifest.hl").write_text(manifest_content, encoding="utf-8")

        # Run hyprcursor-util create with run_bounded
        res = run_bounded(
            ["hyprcursor-util", "--create", str(extracted_theme), "--output", str(created_dir)],
            timeout=TIMEOUT_CONVERT, stdout_limit=LIMIT_STDOUT_MEDIUM, stderr_limit=LIMIT_STDERR_DEFAULT
        )
        if not res.ok:
            sys.stderr.write(f"cursorctl: failed to create Hyprcursor package for '{xcursor}': {res.stderr}\n")
            sys.exit(1)

        created_theme = None
        for d in created_dir.iterdir():
            if d.is_dir() and d.name.startswith("theme_"):
                created_theme = d
                break
        if not created_theme:
            sys.stderr.write(f"cursorctl: hyprcursor-util create produced no output for '{xcursor}'\n")
            sys.exit(1)

        # Atomic installation into user icons directory
        temp_install = Path(tempfile.mkdtemp(prefix=".convert-", dir=str(user_icons)))
        try:
            shutil.copytree(created_theme, temp_install, dirs_exist_ok=True, symlinks=True)
            (temp_install / ".cursor-theme-manager-generated").write_text(
                f"version=1\nkind=conversion-cache\nsourceTheme={xcursor}\n", encoding="utf-8"
            )
            (temp_install / ".omarchy-cursor-switcher-converted").write_text("1.0\n", encoding="utf-8")
            if target_dir.exists():
                marker = target_dir / ".cursor-theme-manager-generated"
                if target_dir.is_symlink() or not marker.is_file() or marker.is_symlink():
                    sys.stderr.write(f"cursorctl: refusing to replace unmanaged directory '{target_dir}'\n")
                    sys.exit(1)
                marker_text = marker.read_text(encoding="utf-8", errors="strict")[:4096]
                if "kind=conversion-cache" not in marker_text:
                    sys.stderr.write(f"cursorctl: refusing to replace invalid conversion cache '{target_dir}'\n")
                    sys.exit(1)
                shutil.rmtree(target_dir)
            os.rename(temp_install, target_dir)
        finally:
            if temp_install.exists():
                shutil.rmtree(temp_install, ignore_errors=True)

        return converted_name
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)


def run_set_size_live(hypr: str, xcursor: str, theme_path: str, size: int):
    if size not in secure_state.SUPPORTED_SIZES:
        sys.stderr.write(f"cursorctl: unsupported cursor size: {size}\n")
        sys.exit(1)

    if hypr not in ("", "-") and not valid_name(hypr):
        sys.stderr.write("cursorctl: invalid Hyprcursor theme name\n")
        sys.exit(1)
    if xcursor not in ("", "-") and not valid_name(xcursor):
        sys.stderr.write("cursorctl: invalid XCursor theme name\n")
        sys.exit(1)

    effective_hypr = "-"
    if hypr and hypr != "-" and valid_name(hypr):
        effective_hypr = hypr
    elif xcursor and xcursor != "-" and valid_name(xcursor):
        effective_hypr = run_ensure_hyprcursor(hypr, xcursor, theme_path)

    if effective_hypr != "-":
        try:
            perform_live_cursor_mutation(effective_hypr, size)
            sys.exit(0)
        except RuntimeError as exc:
            sys.stderr.write(f"cursorctl: {exc}\n")
            sys.exit(1)
    else:
        sys.stderr.write("cursorctl: no valid cursor theme for live size change\n")
        sys.exit(1)


def trace_mutation_barrier(stage: str, expected_fingerprint: Optional[str], state=None) -> None:
    if os.environ.get("CTM_LIFECYCLE_TRACE") != "1":
        return
    current = state if isinstance(state, dict) else {}
    identity = secure_state.get_state_file_identity()
    details = {
        "stage": stage,
        "expectedPluginFingerprint": expected_fingerprint,
        "observedPluginFingerprint": current.get("integrationPluginFingerprint"),
        "observedIntegrationInstanceId": current.get("integrationInstanceId"),
        "stateIdentity": list(identity) if identity else None,
        "baselineCaptured": bool((current.get("preCtmCursor") or current.get("originalCursor") or {}).get("captured")),
        "cursorModifiedByCtm": bool(current.get("cursorModifiedByCtm")),
    }
    sys.stderr.write("CTM_MUTATION_BARRIER " + json.dumps(details, sort_keys=True) + "\n")


def ensure_first_mutation_barrier(expected_fingerprint: Optional[str] = None) -> Dict[str, Any]:
    """Durably record the immutable baseline before any CTM live mutation."""
    expected_fingerprint = expected_fingerprint or _REQUEST_PLUGIN_FINGERPRINT
    for attempt in range(2):
        st = secure_state.read_state()
        trace_mutation_barrier("state-read", expected_fingerprint, st)
        observed_fingerprint = st.get("integrationPluginFingerprint")
        if expected_fingerprint and observed_fingerprint and observed_fingerprint != expected_fingerprint:
            raise RuntimeError("installation recovery is still in progress; no cursor change was applied; retry shortly")

        baseline = st.get("preCtmCursor") or st.get("originalCursor")
        if not (baseline and baseline.get("captured")):
            trace_mutation_barrier("baseline-capture", expected_fingerprint, st)
            baseline = secure_state.capture_original_cursor()
            if not (baseline and baseline.get("captured")):
                raise RuntimeError("could not capture the original cursor safely; no cursor change was applied")

        # Bind recovery material to this plugin generation before setcursor.
        if expected_fingerprint:
            st["integrationPluginFingerprint"] = expected_fingerprint
        st["preCtmCursor"] = baseline
        st["originalCursor"] = baseline
        st["cursorModifiedByCtm"] = True
        trace_mutation_barrier("baseline-write", expected_fingerprint, st)
        if not secure_state.write_state(st):
            raise RuntimeError("failed to durably persist the original cursor; no cursor change was applied")
        # write_state returns only after file fsync, atomic replace, and state
        # directory fsync have all completed.
        trace_mutation_barrier("file-and-directory-fsync-complete", expected_fingerprint, st)

        verified = secure_state.read_state()
        trace_mutation_barrier("durability-reread", expected_fingerprint, verified)
        verified_baseline = verified.get("preCtmCursor") or verified.get("originalCursor")
        owner_matches = not expected_fingerprint or verified.get("integrationPluginFingerprint") == expected_fingerprint
        if (verified.get("cursorModifiedByCtm") and verified_baseline and
                verified_baseline.get("captured") and owner_matches):
            trace_mutation_barrier("durability-verified", expected_fingerprint, verified)
            return verified_baseline

        # One bounded retry handles a state inode replacement that completed
        # while an older cleanup generation was reconciling. Never mutate live
        # cursor state until a stable second verification succeeds.
        if attempt == 0 and (not expected_fingerprint or
                             integration_manager.get_plugin_installation_fingerprint() == expected_fingerprint):
            trace_mutation_barrier("bounded-reconciliation-retry", expected_fingerprint, verified)
            continue
        raise RuntimeError("installation state changed during durability verification; no cursor change was applied; retry shortly")

    raise RuntimeError("installation state changed during durability verification; no cursor change was applied; retry shortly")


def perform_live_cursor_mutation(theme: str, size: int, expected_fingerprint: Optional[str] = None):
    """The sole cursorctl setcursor gateway: durable barrier, then hyprctl."""
    if not valid_name(theme):
        raise RuntimeError("invalid live cursor theme")
    if size not in secure_state.SUPPORTED_SIZES:
        raise RuntimeError(f"unsupported cursor size: {size}")

    baseline = ensure_first_mutation_barrier(expected_fingerprint)
    trace_mutation_barrier("hyprctl-invocation", expected_fingerprint or _REQUEST_PLUGIN_FINGERPRINT, secure_state.read_state())
    result = run_bounded(["hyprctl", "setcursor", theme, str(size)], timeout=TIMEOUT_APPLY)
    if not result.ok:
        detail = sanitize_text(result.stderr or result.error or "hyprctl setcursor failed", 512)
        raise RuntimeError(detail)
    return {"ok": True, "preCtmCursor": baseline, "cursorModifiedByCtm": True}


def _write_private_file(file_path: str, content: str, mode: int = 0o600) -> None:
    parent_dir = os.path.dirname(file_path)
    os.makedirs(parent_dir, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(prefix=f".{os.path.basename(file_path)}.tmp.", dir=parent_dir)
    try:
        os.fchmod(fd, mode)
        with open(fd, "w", encoding="utf-8", closefd=False) as f:
            f.write(content)
            f.flush()
            os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.replace(tmp_path, file_path)
    except Exception:
        try: os.unlink(tmp_path)
        except OSError: pass
        raise


def run_persist_size(hypr: str, xcursor: str, size: int):
    if size not in secure_state.SUPPORTED_SIZES:
        sys.stderr.write(f"cursorctl: unsupported cursor size: {size}\n")
        sys.exit(1)
    if hypr not in ("", "-") and not valid_name(hypr):
        sys.stderr.write("cursorctl: invalid Hyprcursor theme name\n")
        sys.exit(1)
    if xcursor not in ("", "-") and not valid_name(xcursor):
        sys.stderr.write("cursorctl: invalid XCursor theme name\n")
        sys.exit(1)

    ensure_first_mutation_barrier()

    # 1. Atomic state update (immutable preCtmCursor baseline)
    st = secure_state.read_state()
    st["size"] = size
    st["cursorModifiedByCtm"] = True
    if not secure_state.write_state(st):
        raise RuntimeError("failed to persist cursor size")

    # 2. GTK cursor size via gsettings
    run_bounded(["gsettings", "set", "org.gnome.desktop.interface", "cursor-size", str(size)], timeout=1.5)

    # 3. Environment updates (systemd & dbus)
    assignments = [f"XCURSOR_SIZE={size}", f"HYPRCURSOR_SIZE={size}"]
    if hypr and hypr != "-":
        assignments.append(f"HYPRCURSOR_THEME={hypr}")
    if xcursor and xcursor != "-":
        assignments.append(f"XCURSOR_THEME={xcursor}")

    run_bounded(["systemctl", "--user", "set-environment"] + assignments, timeout=1.5)
    run_bounded(["dbus-update-activation-environment", "--systemd"] + assignments, timeout=1.5)

    # 4. Composite Hyprland environment eval in single socket command
    eval_code = f'hl.env("HYPRCURSOR_SIZE", "{size}"); hl.env("XCURSOR_SIZE", "{size}")'
    run_bounded(["hyprctl", "eval", eval_code], timeout=1.5)

    # 5. UWSM environment drop-in files (atomic descriptor write)
    home = os.environ.get("HOME", os.path.expanduser("~"))
    config_home = os.environ.get("XDG_CONFIG_HOME", os.path.join(home, ".config"))
    common_file = os.path.join(config_home, "uwsm", "env.d", "90-omarchy-cursor-switcher")
    hypr_file = os.path.join(config_home, "uwsm", "env-hyprland.d", "90-omarchy-cursor-switcher")

    common_content = "# Managed by sanjyay.cursor-theme-manager.\n"
    if xcursor and xcursor != "-":
        common_content += f"export XCURSOR_THEME='{xcursor}'\n"
    common_content += f"export XCURSOR_SIZE='{size}'\n"

    hypr_content = "# Managed by sanjyay.cursor-theme-manager.\n"
    if not hypr or hypr == "-":
        hypr_content += "unset HYPRCURSOR_THEME\n"
    else:
        hypr_content += f"export HYPRCURSOR_THEME='{hypr}'\n"
    hypr_content += f"export HYPRCURSOR_SIZE='{size}'\n"

    _write_private_file(common_file, common_content, 0o600)
    _write_private_file(hypr_file, hypr_content, 0o600)


def run_capture_baseline():
    try:
        baseline = ensure_first_mutation_barrier()
        emit_bounded_json({"ok": True, "preCtmCursor": baseline, "cursorModifiedByCtm": True})
        sys.exit(0)
    except RuntimeError as exc:
        sys.stderr.write(f"cursorctl: {exc}\n")
        sys.exit(1)


def run_persist_theme(theme_json: str, size: int):
    if size not in secure_state.SUPPORTED_SIZES:
        sys.stderr.write(f"cursorctl: unsupported cursor size: {size}\n")
        sys.exit(1)

    try:
        theme = json.loads(theme_json)
    except Exception as e:
        sys.stderr.write(f"cursorctl: invalid theme json: {e}\n")
        sys.exit(1)

    hypr = theme.get("hyprcursor", "-")
    xcursor = theme.get("xcursor", "-")
    if hypr != "-" and not valid_name(hypr):
        hypr = "-"
    if xcursor != "-" and not valid_name(xcursor):
        xcursor = "-"

    # Persistent mutation cannot precede the same durable barrier used by
    # every live setcursor route.
    ensure_first_mutation_barrier()

    # 1. Atomic state update (immutable preCtmCursor baseline)
    st = secure_state.read_state()
    st["theme"] = theme
    st["size"] = size
    st["cursorModifiedByCtm"] = True
    if not (st.get("preCtmCursor") and st["preCtmCursor"].get("captured")):
        baseline = secure_state.capture_original_cursor()
        st["preCtmCursor"] = baseline
        st["originalCursor"] = baseline
    secure_state.write_state(st)

    # 2. GTK cursor theme & size via gsettings
    if xcursor and xcursor != "-":
        run_bounded(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", xcursor], timeout=1.5)
    run_bounded(["gsettings", "set", "org.gnome.desktop.interface", "cursor-size", str(size)], timeout=1.5)

    # 3. Environment updates (systemd & dbus)
    assignments = [f"XCURSOR_SIZE={size}", f"HYPRCURSOR_SIZE={size}"]
    if hypr and hypr != "-":
        assignments.append(f"HYPRCURSOR_THEME={hypr}")
    if xcursor and xcursor != "-":
        assignments.append(f"XCURSOR_THEME={xcursor}")

    run_bounded(["systemctl", "--user", "set-environment"] + assignments, timeout=1.5)
    run_bounded(["dbus-update-activation-environment", "--systemd"] + assignments, timeout=1.5)

    # 4. Composite Hyprland environment eval in single socket command
    hypr_env = "" if not hypr or hypr == "-" else hypr
    xcur_env = "" if not xcursor or xcursor == "-" else xcursor
    eval_code = f'hl.env("HYPRCURSOR_THEME", "{hypr_env}"); hl.env("HYPRCURSOR_SIZE", "{size}"); hl.env("XCURSOR_THEME", "{xcur_env}"); hl.env("XCURSOR_SIZE", "{size}")'
    run_bounded(["hyprctl", "eval", eval_code], timeout=1.5)

    # 5. UWSM environment drop-in files (atomic descriptor write)
    home = os.environ.get("HOME", os.path.expanduser("~"))
    config_home = os.environ.get("XDG_CONFIG_HOME", os.path.join(home, ".config"))
    common_file = os.path.join(config_home, "uwsm", "env.d", "90-omarchy-cursor-switcher")
    hypr_file = os.path.join(config_home, "uwsm", "env-hyprland.d", "90-omarchy-cursor-switcher")

    common_content = "# Managed by sanjyay.cursor-theme-manager.\n"
    if xcursor and xcursor != "-":
        common_content += f"export XCURSOR_THEME='{xcursor}'\n"
    common_content += f"export XCURSOR_SIZE='{size}'\n"

    hypr_content = "# Managed by sanjyay.cursor-theme-manager.\n"
    if not hypr or hypr == "-":
        hypr_content += "unset HYPRCURSOR_THEME\n"
    else:
        hypr_content += f"export HYPRCURSOR_THEME='{hypr}'\n"
    hypr_content += f"export HYPRCURSOR_SIZE='{size}'\n"

    _write_private_file(common_file, common_content, 0o600)
    _write_private_file(hypr_file, hypr_content, 0o600)


# ==============================================================================
# APPLY THEME
# ==============================================================================

def run_apply(hypr: str, xcursor: str, theme_path: str, size: int, mode: str):
    if size not in secure_state.SUPPORTED_SIZES:
        sys.stderr.write(f"cursorctl: unsupported cursor size: {size}\n")
        sys.exit(1)

    if hypr != "-" and not valid_name(hypr):
        sys.stderr.write("cursorctl: invalid Hyprcursor theme name\n")
        sys.exit(1)
    if xcursor != "-" and not valid_name(xcursor):
        sys.stderr.write("cursorctl: invalid XCursor theme name\n")
        sys.exit(1)

    effective_hypr = run_ensure_hyprcursor(hypr, xcursor, theme_path)

    # Preview, restore, cancel, import and commit routes all share the barrier.
    try:
        perform_live_cursor_mutation(effective_hypr, size)
    except RuntimeError as exc:
        sys.stderr.write(f"cursorctl: {exc}\n")
        sys.exit(1)

    # 2. If commit mode
    if mode == "--commit":
        hypr_env = "" if effective_hypr == "-" else effective_hypr
        run_bounded(["hyprctl", "eval", f'hl.env("HYPRCURSOR_THEME", "{hypr_env}")'], timeout=2.0)
        run_bounded(["hyprctl", "eval", f'hl.env("HYPRCURSOR_SIZE", "{size}")'], timeout=2.0)
        if xcursor != "-":
            run_bounded(["hyprctl", "eval", f'hl.env("XCURSOR_THEME", "{xcursor}")'], timeout=2.0)
            run_bounded(["hyprctl", "eval", f'hl.env("XCURSOR_SIZE", "{size}")'], timeout=2.0)

    # 3. GTK cursor via gsettings
    if xcursor != "-":
        run_bounded(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", xcursor], timeout=2.0)
        run_bounded(["gsettings", "set", "org.gnome.desktop.interface", "cursor-size", str(size)], timeout=2.0)

    # 4. Systemd & DBus environment
    assignments = [f"XCURSOR_SIZE={size}", f"HYPRCURSOR_SIZE={size}"]
    if effective_hypr != "-":
        assignments.append(f"HYPRCURSOR_THEME={effective_hypr}")
    if xcursor != "-":
        assignments.append(f"XCURSOR_THEME={xcursor}")

    run_bounded(["systemctl", "--user", "set-environment"] + assignments, timeout=2.0)
    run_bounded(["dbus-update-activation-environment", "--systemd"] + assignments, timeout=2.0)

    # 5. UWSM drop-in files
    if mode == "--commit":
        home = os.environ.get("HOME", os.path.expanduser("~"))
        config_home = os.environ.get("XDG_CONFIG_HOME", os.path.join(home, ".config"))
        common_file = os.path.join(config_home, "uwsm", "env.d", "90-omarchy-cursor-switcher")
        hypr_file = os.path.join(config_home, "uwsm", "env-hyprland.d", "90-omarchy-cursor-switcher")

        common_content = "# Managed by sanjyay.cursor-theme-manager.\n"
        if xcursor != "-":
            common_content += f"export XCURSOR_THEME='{xcursor}'\n"
        common_content += f"export XCURSOR_SIZE='{size}'\n"

        hypr_content = "# Managed by sanjyay.cursor-theme-manager.\n"
        if effective_hypr == "-":
            hypr_content += "unset HYPRCURSOR_THEME\n"
        else:
            hypr_content += f"export HYPRCURSOR_THEME='{effective_hypr}'\n"
        hypr_content += f"export HYPRCURSOR_SIZE='{size}'\n"

        _write_private_file(common_file, common_content, 0o600)
        _write_private_file(hypr_file, hypr_content, 0o600)


# ==============================================================================
# MAIN ROUTING
# ==============================================================================

def main():
    global _REQUEST_PLUGIN_FINGERPRINT
    if len(sys.argv) < 2:
        sys.stderr.write("Usage: cursorctl {installation-identity|discover|apply|ensure-hyprcursor|import|remove-imported|rename-imported|list-dir|choose-file|get-preview-roles|get-all-preview-roles|open-folder|state-read|state-write|launcher-status|launcher-add|launcher-remove|launcher-dismiss-prompt} ...\n")
        sys.exit(1)

    cmd = sys.argv[1]

    def option_value(name):
        try:
            pos = sys.argv.index(name, 2)
            return sys.argv[pos + 1] if pos + 1 < len(sys.argv) else None
        except ValueError:
            return None

    def forwarded_command_args():
        """Remove cursorctl-only binding options before delegated argparse parsers."""
        forwarded = []
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--plugin-fingerprint":
                i += 2
                continue
            forwarded.append(sys.argv[i])
            i += 1
        return forwarded

    mutating_commands = {
        "capture-baseline", "ensure-hyprcursor", "setcursor-live", "persist-theme", "persist-size",
        "set-size-live", "apply", "state-write", "import", "remove-imported",
        "rename-imported", "launcher-add", "integration-enable", "recovery-reconcile",
        "integration-install", "register-app", "launcher-remove",
        "integration-disable", "integration-remove", "unregister-app",
    }
    expected_fingerprint = option_value("--plugin-fingerprint")
    _REQUEST_PLUGIN_FINGERPRINT = expected_fingerprint
    if cmd in mutating_commands:
        current_fingerprint = integration_manager.get_plugin_installation_fingerprint()
        trace_mutation_barrier("current-installation-identity-read", expected_fingerprint, {
            "integrationPluginFingerprint": current_fingerprint
        })
        home = os.environ.get("HOME", os.path.expanduser("~"))
        config_home = os.environ.get("XDG_CONFIG_HOME", os.path.join(home, ".config"))
        canonical_install = os.path.join(
            config_home, "omarchy", "plugins", integration_manager.PLUGIN_ID
        )
        running_from_installed_plugin = False
        try:
            running_from_installed_plugin = (
                os.path.lexists(canonical_install) and
                os.path.samefile(str(SCRIPT_DIR.parent), canonical_install)
            )
        except OSError:
            pass
        if ((running_from_installed_plugin and not expected_fingerprint) or
                (expected_fingerprint and expected_fingerprint != current_fingerprint)):
            emit_bounded_json({
                "ok": False,
                "error": "This request belongs to a removed Cursor Theme Manager installation. Reopen CTM and try again."
            }, exit_code=1)
        if expected_fingerprint and cmd != "recovery-reconcile":
            lifecycle_status = integration_manager.get_status()
            trace_mutation_barrier("recovery-state-classification", expected_fingerprint, secure_state.read_state())
            if lifecycle_status.get("recoveryPending"):
                emit_bounded_json({
                    "ok": False,
                    "recoveryPending": True,
                    "error": "The previous Cursor Theme Manager installation is still restoring the cursor."
                }, exit_code=1)

    if cmd == "installation-identity":
        res = integration_manager.ensure_installation_identity()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)

    elif cmd == "recovery-reconcile":
        import cleanup_helper
        res = cleanup_helper.reconcile_orphaned_state(expected_fingerprint or "")
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)

    elif cmd == "discover":
        run_discover()

    elif cmd == "ensure-hyprcursor":
        hypr = ""
        xcursor = ""
        theme_path = ""
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--hyprcursor" and i + 1 < len(sys.argv):
                hypr = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--xcursor" and i + 1 < len(sys.argv):
                xcursor = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--theme-path" and i + 1 < len(sys.argv):
                theme_path = sys.argv[i+1]; i += 2
            elif not sys.argv[i].startswith("--"):
                if not hypr: hypr = sys.argv[i]
                elif not xcursor: xcursor = sys.argv[i]
                elif not theme_path: theme_path = sys.argv[i]
                i += 1
            else:
                i += 1
        res = run_ensure_hyprcursor(hypr, xcursor, theme_path)
        sys.stdout.write(res + "\n")
        sys.exit(0)

    elif cmd == "capture-baseline":
        run_capture_baseline()

    elif cmd == "setcursor-live":
        theme = ""
        size = 24
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--theme" and i + 1 < len(sys.argv):
                theme = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--size" and i + 1 < len(sys.argv):
                try: size = int(sys.argv[i+1])
                except ValueError: pass
                i += 2
            else:
                i += 1
        try:
            emit_bounded_json(perform_live_cursor_mutation(theme, size, expected_fingerprint))
            sys.exit(0)
        except RuntimeError as exc:
            sys.stderr.write(f"cursorctl: {exc}\n")
            sys.exit(1)

    elif cmd == "persist-theme":
        theme_json = "{}"
        size = 24
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--theme" and i + 1 < len(sys.argv):
                theme_json = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--size" and i + 1 < len(sys.argv):
                try: size = int(sys.argv[i+1])
                except ValueError: pass
                i += 2
            else:
                i += 1
        run_persist_theme(theme_json, size)
        emit_bounded_json({"ok": True})
        sys.exit(0)

    elif cmd == "persist-size":
        hypr = "-"; xcursor = "-"; size = 24
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--hyprcursor" and i + 1 < len(sys.argv):
                hypr = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--xcursor" and i + 1 < len(sys.argv):
                xcursor = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--size" and i + 1 < len(sys.argv):
                try: size = int(sys.argv[i+1])
                except ValueError: pass
                i += 2
            else:
                i += 1
        run_persist_size(hypr, xcursor, size)
        emit_bounded_json({"ok": True, "persistedSize": size})
        sys.exit(0)

    elif cmd == "set-size-live":
        hypr = "-"; xcursor = "-"; theme_path = ""; size = 24
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--hyprcursor" and i + 1 < len(sys.argv):
                hypr = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--xcursor" and i + 1 < len(sys.argv):
                xcursor = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--theme-path" and i + 1 < len(sys.argv):
                theme_path = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--size" and i + 1 < len(sys.argv):
                try: size = int(sys.argv[i+1])
                except ValueError: pass
                i += 2
            else:
                i += 1
        run_set_size_live(hypr, xcursor, theme_path, size)
        sys.exit(0)

    elif cmd == "apply":
        hypr = ""
        xcursor = ""
        theme_path = ""
        size = 16
        mode = "--preview"
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--hyprcursor" and i + 1 < len(sys.argv):
                hypr = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--xcursor" and i + 1 < len(sys.argv):
                xcursor = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--theme-path" and i + 1 < len(sys.argv):
                theme_path = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--size" and i + 1 < len(sys.argv):
                try: size = int(sys.argv[i+1])
                except ValueError: pass
                i += 2
            elif sys.argv[i] in ("--preview", "--commit"):
                mode = sys.argv[i]; i += 1
            else:
                i += 1
        run_apply(hypr, xcursor, theme_path, size, mode)
        sys.exit(0)

    elif cmd == "open-folder":
        path = ""
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--path" and i + 1 < len(sys.argv):
                path = sys.argv[i+1]; i += 2
            elif not sys.argv[i].startswith("--"):
                path = sys.argv[i]; i += 1
            else:
                i += 1
        if path and os.path.isdir(path):
            run_bounded(["xdg-open", path], timeout=TIMEOUT_OPEN_FOLDER)
            emit_bounded_json({"ok": True})
        else:
            emit_bounded_json({"ok": False, "error": "Invalid directory path"}, exit_code=1)

    elif cmd == "state-read":
        st = secure_state.read_state()
        int_status = integration_manager.get_status()
        # During remove -> immediate reinstall, the old cleanup deliberately
        # retains its immutable recovery state until live restoration succeeds.
        # Never expose that old installation's selected theme to the new QML
        # instance: initialize() would otherwise replay it after cleanup has
        # correctly restored the cursor. Imported themes are user data and are
        # safe to carry across installations.
        if int_status.get("recoveryPending"):
            st = secure_state.validate_state_dict({
                "importedThemes": st.get("importedThemes", [])
            })
            st["recoveryPending"] = True
            st["recoveryOrphaned"] = bool(int_status.get("recoveryOrphaned"))
        st["integrationEnabled"] = int_status["enabled"]
        st["integrationPromptSeen"] = int_status["promptSeen"]
        st["launcherAdded"] = int_status["enabled"]
        st["launcherPromptSeen"] = int_status["promptSeen"]
        st["integrationInstanceId"] = int_status.get("instanceId")
        st["integrationPluginFingerprint"] = int_status.get("pluginFingerprint")
        st["trustedTools"] = {
            "hyprctl": resolve_system_executable("hyprctl") or ""
        }
        emit_bounded_json(st, max_bytes=LIMIT_STDOUT_SMALL)

    elif cmd == "state-write":
        state_json = ""
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--state" and i + 1 < len(sys.argv):
                state_json = sys.argv[i+1]; i += 2
            else:
                i += 1
        if not state_json and not sys.stdin.isatty():
            state_json = sys.stdin.read(secure_state.MAX_STATE_BYTES + 1)
        try:
            data = json.loads(state_json)
            ok = secure_state.write_state(data)
            emit_bounded_json({"ok": ok})
        except Exception as exc:
            emit_bounded_json({"ok": False, "error": str(exc)}, exit_code=1)

    elif cmd in ("launcher-status", "integration-status"):
        res = integration_manager.get_status()
        emit_bounded_json(res)

    elif cmd in ("launcher-add", "integration-enable", "integration-install", "register-app"):
        res = integration_manager.enable_integration(expected_fingerprint)
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)

    elif cmd in ("launcher-remove", "integration-disable", "integration-remove", "unregister-app"):
        res = integration_manager.disable_integration(expected_fingerprint)
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)

    elif cmd in ("launcher-dismiss-prompt", "integration-dismiss-prompt", "dismiss-prompt"):
        res = integration_manager.dismiss_prompt()
        emit_bounded_json(res)

    # Forwarding to other sub-scripts with sys.argv preservation
    elif cmd == "import":
        import importlib
        cursor_import = importlib.import_module("cursor-import")
        sys.argv = ["cursor-import.py", "import"] + forwarded_command_args()
        cursor_import.main()

    elif cmd == "remove-imported":
        import importlib
        cursor_import = importlib.import_module("cursor-import")
        # Support positional ID or --id
        args = forwarded_command_args()
        if len(args) == 1 and not args[0].startswith("--"):
            args = ["--id", args[0]]
        sys.argv = ["cursor-import.py", "remove"] + args
        cursor_import.main()

    elif cmd == "rename-imported":
        import importlib
        cursor_import = importlib.import_module("cursor-import")
        sys.argv = ["cursor-import.py", "rename"] + forwarded_command_args()
        cursor_import.main()

    elif cmd == "list-dir":
        sys.argv = ["file_browser.py"] + sys.argv[2:]
        file_browser.main()

    elif cmd == "choose-file":
        import importlib
        choose_file = importlib.import_module("choose-file")
        sys.argv = ["choose-file.py"] + sys.argv[2:]
        choose_file.main()

    elif cmd == "get-preview-roles":
        sys.argv = ["cursor_theming.py", "get-preview-roles"] + sys.argv[2:]
        cursor_theming.main()

    elif cmd == "get-all-preview-roles":
        sys.argv = ["cursor_theming.py", "get-all-preview-roles"] + sys.argv[2:]
        cursor_theming.main()

    else:
        sys.stderr.write(f"cursorctl: unknown command '{cmd}'\n")
        sys.exit(1)


if __name__ == "__main__":
    main()
