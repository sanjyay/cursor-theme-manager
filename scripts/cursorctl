#!/usr/bin/env bash
set -euo pipefail

PROGRAM=${0##*/}
NAME_RE='^[A-Za-z0-9][A-Za-z0-9._+ -]{0,127}$'

die() { printf '%s: %s\n' "$PROGRAM" "$*" >&2; exit 1; }
log() { printf '%s: %s\n' "$PROGRAM" "$*" >&2; }

valid_name() {
  [[ $1 =~ $NAME_RE ]] && [[ $1 != *..* ]]
}

json_string() {
  local value=$1
  value=${value//\\/\\\\}; value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}; value=${value//$'\r'/\\r}; value=${value//$'\t'/\\t}
  printf '"%s"' "$value"
}

read_key() {
  local file=$1 key=$2 line value
  [[ -f $file && ! -L $file ]] || return 0
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*${key}[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
    value=${BASH_REMATCH[1]}
    value=${value%%#*}; value=${value%%;*}
    value=${value#\"}; value=${value%\"}; value=${value#\'}; value=${value%\'}
    value=${value##+([[:space:]])}; value=${value%%+([[:space:]])}
    printf '%s' "$value"
    return 0
  done < "$file"
}

safe_theme_dir() {
  local root=$1 dir=$2 real_root real_dir
  real_root=$(readlink -f -- "$root") || return 1
  real_dir=$(readlink -f -- "$dir") || return 1
  [[ $real_dir == "$real_root"/* ]]
}

has_xcursor() {
  local dir=$1 candidate resolved
  [[ -d $dir/cursors ]] || return 1
  for candidate in left_ptr default arrow; do
    [[ -e $dir/cursors/$candidate ]] || continue
    resolved=$(readlink -f -- "$dir/cursors/$candidate") || continue
    [[ $resolved == "$(readlink -f -- "$dir")"/* ]] && return 0
  done
  return 1
}

has_hyprcursor() {
  local dir=$1 cursors
  [[ -f $dir/manifest.hl || -f $dir/manifest.toml ]] || return 1
  cursors=$(read_key "$dir/manifest.hl" cursors_directory)
  [[ -n $cursors ]] || cursors=$(read_key "$dir/manifest.toml" cursors_directory)
  valid_name "${cursors:-hyprcursors}" || return 1
  [[ -d $dir/${cursors:-hyprcursors} ]]
}

get_preview_path() {
  local dir=$1
  local base=${dir##*/}
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-cursor-switcher/previews"
  local preview_png="$cache_dir/$base.png"

  if [[ -f $preview_png ]]; then
    printf '%s' "$preview_png"
    return 0
  fi

  if [[ -d $dir/cursors ]]; then
    local cur_path=""
    local candidate
    for candidate in left_ptr default arrow pointer top_left_arrow; do
      if [[ -f $dir/cursors/$candidate ]]; then
        cur_path="$dir/cursors/$candidate"
        break
      fi
    done

    if [[ -n $cur_path ]] && command -v xcur2png >/dev/null 2>&1; then
      mkdir -p "$cache_dir"
      local temp_dir
      temp_dir=$(mktemp -d -t .preview.XXXXXX)
      if (cd "$temp_dir" && xcur2png "$cur_path" >/dev/null 2>&1); then
        local best_png
        best_png=$(find "$temp_dir" -type f -name "*.png" -size +100c 2>/dev/null | sort -V | tail -n1)
        if [[ -n $best_png && -f $best_png ]]; then
          if command -v magick >/dev/null 2>&1; then
            magick "$best_png" -resize 64x64 "$preview_png" >/dev/null 2>&1 || cp "$best_png" "$preview_png"
          else
            cp "$best_png" "$preview_png"
          fi
          rm -rf -- "$temp_dir"
          printf '%s' "$preview_png"
          return 0
        fi
      fi
      rm -rf -- "$temp_dir"
    fi
  fi

  printf ''
}

discover() {
  local home=${HOME:?HOME is not set} root dir base
  local first=1 display hypr xcursor formats path manifest_name index_name is_imported source_type subtitle
  local -a roots=("${XDG_DATA_HOME:-$home/.local/share}/icons" "$home/.icons")
  IFS=: read -ra system_roots <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for root in "${system_roots[@]}"; do roots+=("$root/icons"); done

  printf '{"themes":['
  shopt -s nullglob extglob
  for root in "${roots[@]}"; do
    [[ -d $root ]] || continue
    local is_sys_root=false
    if [[ $root != "${XDG_DATA_HOME:-$home/.local/share}/icons" && $root != "$home/.icons" ]]; then
      is_sys_root=true
    fi


    for dir in "$root"/*; do
      [[ -d $dir ]] || continue
      safe_theme_dir "$root" "$dir" || continue
      base=${dir##*/}; valid_name "$base" || continue

      # Skip internal generated converted themes in discovery list
      [[ $base == CursorSwitcher-XCursor-* || $base == CursorSwitcher-Themed-* ]] && continue

      hypr=""; xcursor=""; formats=""; display=""; is_imported=false; source_type="user"; subtitle=""
      if has_hyprcursor "$dir"; then
        manifest_name=$(read_key "$dir/manifest.hl" name)
        [[ -n $manifest_name ]] || manifest_name=$(read_key "$dir/manifest.toml" name)
        valid_name "${manifest_name:-$base}" || manifest_name=$base
        hypr=${manifest_name:-$base}; display=$hypr; formats='"hyprcursor"'
      fi
      if has_xcursor "$dir"; then
        xcursor=$base
        index_name=$(read_key "$dir/index.theme" Name)
        if valid_name "${index_name:-$base}"; then display=${index_name:-$display}; fi
        [[ -n $display ]] || display=$base
        [[ -n $formats ]] && formats+=','
        formats+='"xcursor"'
      fi
      [[ -n $formats ]] || continue
      path=$(readlink -f -- "$dir")

      local import_license=""
      if [[ -f $dir/.omarchy-cursor-switcher-imported ]]; then
        is_imported=true
        source_type="imported"
        local imp_name imp_lic
        imp_name=$(python3 -c "import json, sys; m=json.load(open(sys.argv[1])); print(m.get('displayName',''))" "$dir/.omarchy-cursor-switcher-imported" 2>/dev/null || true)
        imp_lic=$(python3 -c "import json, sys; m=json.load(open(sys.argv[1])); print(m.get('license',''))" "$dir/.omarchy-cursor-switcher-imported" 2>/dev/null || true)
        [[ -n $imp_name ]] && display="$imp_name"
        import_license="$imp_lic"
        if [[ -n $import_license && $import_license != "Unknown" ]]; then
          subtitle="Imported • $import_license"
        else
          subtitle="Imported"
        fi
      elif [[ $is_sys_root == true ]]; then
        source_type="system"
        local idx_comment
        idx_comment=$(read_key "$dir/index.theme" Comment)
        if [[ -n $idx_comment ]]; then
          subtitle="$idx_comment"
        else
          subtitle="System"
        fi
      else
        source_type="user"
        local idx_comment
        idx_comment=$(read_key "$dir/index.theme" Comment)
        if [[ -n $idx_comment ]]; then
          subtitle="$idx_comment"
        else
          subtitle="User"
        fi
      fi

      local theme_preview
      theme_preview=$(get_preview_path "$dir")

      (( first )) || printf ','
      first=0
      printf '{"id":'; json_string "$base"
      printf ',"displayName":'; json_string "$display"
      printf ',"family":'; json_string "$display"
      printf ',"subtitle":'; json_string "$subtitle"
      printf ',"hyprcursor":'; json_string "$hypr"
      printf ',"xcursor":'; json_string "$xcursor"
      printf ',"path":'; json_string "$path"
      printf ',"formats":[%s],"imported":%s,"sourceType":' "$formats" "$is_imported"
      json_string "$source_type"
      printf ',"license":'
      json_string "${import_license:-Unknown}"
      printf ',"previewPath":'
      json_string "$theme_preview"
      printf '}'
    done
  done
  printf '],"currentXcursor":'
  local current=""
  if command -v gsettings >/dev/null 2>&1; then
    current=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null || true)
    current=${current#\'}; current=${current%\'}
  fi
  if [[ $current == default && -f /usr/share/icons/default/index.theme && ! -L /usr/share/icons/default/index.theme ]]; then
    local inherited
    inherited=$(read_key /usr/share/icons/default/index.theme Inherits)
    if valid_name "${inherited:-}"; then current=$inherited; fi
  fi
  json_string "$current"
  printf '}\n'
}


ensure_hyprcursor() {
  local hypr=$1 xcursor=$2 theme_path=${3:-} home=${HOME:?HOME is not set}

  # If native Hyprcursor is provided, check if it actually exists
  if [[ $hypr != - && -n $hypr ]]; then
    local -a check_roots=("${XDG_DATA_HOME:-$home/.local/share}/icons" "$home/.icons")
    IFS=: read -ra sys_roots <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for r in "${sys_roots[@]}"; do check_roots+=("$r/icons"); done
    for r in "${check_roots[@]}"; do
      [[ -d $r ]] || continue
      for d in "$r"/*; do
        [[ -d $d ]] || continue
        if has_hyprcursor "$d"; then
          local mname
          mname=$(read_key "$d/manifest.hl" name)
          [[ -n $mname ]] || mname=$(read_key "$d/manifest.toml" name)
          if [[ $mname == "$hypr" || ${d##*/} == "$hypr" ]]; then
            printf '%s' "$hypr"
            return 0
          fi
        fi
      done
    done
  fi

  [[ $xcursor != - && -n $xcursor ]] || die "no cursor theme specified"

  # Find XCursor theme directory
  local xdir=""
  if [[ -n $theme_path && -d $theme_path/cursors ]]; then
    xdir=$theme_path
  else
    local -a roots=("${XDG_DATA_HOME:-$home/.local/share}/icons" "$home/.icons")
    IFS=: read -ra system_roots <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for root in "${system_roots[@]}"; do roots+=("$root/icons"); done
    for root in "${roots[@]}"; do
      local candidate="$root/$xcursor"
      if [[ -d $candidate/cursors ]]; then
        xdir=$candidate
        break
      fi
    done
  fi

  [[ -n $xdir && -d $xdir/cursors ]] || die "XCursor directory not found for theme '$xcursor'"

  # Compute content hash
  local sig
  if command -v sha256sum >/dev/null 2>&1; then
    sig=$(find "$xdir" -type f -exec stat -c "%n %s %Y" {} + 2>/dev/null | sha256sum | awk '{print $1}')
  else
    sig=$(find "$xdir" -type f -exec stat -c "%n %s %Y" {} + 2>/dev/null | cksum | awk '{print $1}')
  fi
  local hash_short=${sig:0:12}
  local converted_name="CursorSwitcher-XCursor-${xcursor}-${hash_short}"
  local target_parent="${XDG_DATA_HOME:-$home/.local/share}/icons"
  local target_dir="$target_parent/$converted_name"

  if [[ -d $target_dir && -f $target_dir/manifest.hl && -d $target_dir/hyprcursors ]]; then
    printf '%s' "$converted_name"
    return 0
  fi

  command -v hyprcursor-util >/dev/null 2>&1 || die "hyprcursor-util is required to convert XCursor theme '$xcursor'"

  local temp_dir
  temp_dir=$(mktemp -d -t .cs-convert.XXXXXX)
  local clean_source="$temp_dir/clean_source"
  local extracted_dir="$temp_dir/extracted"
  local created_dir="$temp_dir/created"
  mkdir -p "$clean_source/cursors" "$extracted_dir" "$created_dir" "$target_parent"

  if [[ -f $xdir/index.theme ]]; then
    cp -- "$xdir/index.theme" "$clean_source/"
  fi

  local item item_base item_target
  for item in "$xdir/cursors"/*; do
    [[ -e $item || -L $item ]] || continue
    item_base=${item##*/}
    [[ $item_base == *.cur || $item_base == *.ani ]] && continue
    if [[ -L $item ]]; then
      item_target=$(readlink -- "$item") || continue
      [[ $item_target == *.cur || $item_target == *.ani ]] && continue
      ln -s -- "$item_target" "$clean_source/cursors/$item_base"
    elif [[ -f $item ]]; then
      cp -a -- "$item" "$clean_source/cursors/"
    fi
  done

  if ! hyprcursor-util --extract "$clean_source" --output "$extracted_dir" >/dev/null 2>&1; then
    rm -rf -- "$temp_dir"
    die "failed to extract XCursor theme '$xcursor'"
  fi

  local extracted_theme
  extracted_theme=$(find "$extracted_dir" -mindepth 1 -maxdepth 1 -type d -name "extracted_*" | head -n1)
  if [[ -z $extracted_theme || ! -d $extracted_theme ]]; then
    rm -rf -- "$temp_dir"
    die "hyprcursor-util extract produced no output for '$xcursor'"
  fi

  cat <<EOF > "$extracted_theme/manifest.hl"
name = $converted_name
description = Automatically converted from $xcursor by Cursor Switcher
version = 1.0
cursors_directory = hyprcursors
EOF

  if ! hyprcursor-util --create "$extracted_theme" --output "$created_dir" >/dev/null 2>&1; then
    rm -rf -- "$temp_dir"
    die "failed to create Hyprcursor package for '$xcursor'"
  fi

  local created_theme
  created_theme=$(find "$created_dir" -mindepth 1 -maxdepth 1 -type d -name "theme_*" | head -n1)
  if [[ -z $created_theme || ! -d $created_theme ]]; then
    rm -rf -- "$temp_dir"
    die "hyprcursor-util create produced no output for '$xcursor'"
  fi

  local temp_install
  temp_install=$(mktemp -d --tmpdir="$target_parent" .convert.XXXXXX)
  cp -a "$created_theme"/. "$temp_install"/
  printf '%s\n' "1.0" > "$temp_install/.omarchy-cursor-switcher-converted"
  mv -f "$temp_install" "$target_dir"
  rm -rf -- "$temp_dir"

  printf '%s' "$converted_name"
  return 0
}

apply_theme() {
  local hypr="" xcursor="" theme_path="" size="" mode=""
  while (($#)); do
    case $1 in
      --hyprcursor) [[ $# -ge 2 ]] || die "missing Hyprcursor name"; hypr=$2; shift 2 ;;
      --xcursor) [[ $# -ge 2 ]] || die "missing XCursor name"; xcursor=$2; shift 2 ;;
      --theme-path) [[ $# -ge 2 ]] || die "missing theme path"; theme_path=$2; shift 2 ;;
      --size) [[ $# -ge 2 ]] || die "missing size"; size=$2; shift 2 ;;
      --preview|--commit) mode=$1; shift ;;
      *) die "unknown apply argument: $1" ;;
    esac
  done
  [[ $size =~ ^(16|20|24|28|32|40|48|64|80|96|128|160|192|224|256)$ ]] || die "unsupported cursor size: $size"
  [[ $hypr == - ]] || valid_name "$hypr" || die "invalid Hyprcursor theme name"
  [[ $xcursor == - ]] || valid_name "$xcursor" || die "invalid XCursor theme name"
  [[ $hypr != - || $xcursor != - ]] || die "theme has no supported cursor format"

  command -v hyprctl >/dev/null 2>&1 || die "hyprctl is unavailable"

  local effective_hypr
  effective_hypr=$(ensure_hyprcursor "$hypr" "$xcursor" "$theme_path") || die "could not resolve Hyprcursor for $xcursor"

  if ! hyprctl setcursor "$effective_hypr" "$size" >/dev/null; then
    die "hyprctl setcursor failed for '$effective_hypr' ($size px)"
  fi

  if [[ $mode == --commit ]]; then
    local hypr_env=""
    [[ $effective_hypr == - ]] || hypr_env=$effective_hypr
    hyprctl eval "hl.env(\"HYPRCURSOR_THEME\", \"$hypr_env\")" >/dev/null 2>&1 || true
    hyprctl eval "hl.env(\"HYPRCURSOR_SIZE\", \"$size\")" >/dev/null 2>&1 || true
    if [[ $xcursor != - ]]; then
      hyprctl eval "hl.env(\"XCURSOR_THEME\", \"$xcursor\")" >/dev/null 2>&1 || true
      hyprctl eval "hl.env(\"XCURSOR_SIZE\", \"$size\")" >/dev/null 2>&1 || true
    fi
  fi

  if [[ $xcursor != - ]]; then
    if command -v gsettings >/dev/null 2>&1; then
      gsettings set org.gnome.desktop.interface cursor-theme "$xcursor" 2>/dev/null || true
      gsettings set org.gnome.desktop.interface cursor-size "$size" 2>/dev/null || true
    else
      log "gsettings unavailable; GTK cursor could not be updated"
    fi
  fi

  local -a assignments=("XCURSOR_SIZE=$size" "HYPRCURSOR_SIZE=$size")
  [[ $effective_hypr == - ]] || assignments+=("HYPRCURSOR_THEME=$effective_hypr")
  [[ $xcursor == - ]] || assignments+=("XCURSOR_THEME=$xcursor")
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user set-environment "${assignments[@]}" >/dev/null 2>&1 || true
  fi
  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd "${assignments[@]}" >/dev/null 2>&1 || true
  fi

  if [[ $mode == --commit ]]; then
    local config_home=${XDG_CONFIG_HOME:-${HOME:?HOME is not set}/.config}
    local common_dir="$config_home/uwsm/env.d" hypr_dir="$config_home/uwsm/env-hyprland.d"
    local common_file="$common_dir/90-omarchy-cursor-switcher" hypr_file="$hypr_dir/90-omarchy-cursor-switcher"
    local common_tmp hypr_tmp
    mkdir -p -- "$common_dir" "$hypr_dir"
    common_tmp=$(mktemp --tmpdir="$common_dir" .cursor-switcher.XXXXXX)
    hypr_tmp=$(mktemp --tmpdir="$hypr_dir" .cursor-switcher.XXXXXX)
    {
      printf '# Managed by sanjyay.cursor-theme-manager.\n'
      [[ $xcursor == - ]] || printf "export XCURSOR_THEME='%s'\n" "$xcursor"
      printf "export XCURSOR_SIZE='%s'\n" "$size"
    } > "$common_tmp"
    {
      printf '# Managed by sanjyay.cursor-theme-manager.\n'
      if [[ $effective_hypr == - ]]; then printf 'unset HYPRCURSOR_THEME\n'; else printf "export HYPRCURSOR_THEME='%s'\n" "$effective_hypr"; fi
      printf "export HYPRCURSOR_SIZE='%s'\n" "$size"
    } > "$hypr_tmp"
    chmod 600 -- "$common_tmp" "$hypr_tmp"
    mv -f -- "$common_tmp" "$common_file"
    mv -f -- "$hypr_tmp" "$hypr_file"
  fi
}

register_app() {

  local source_dir="" home=${HOME:?HOME is not set}
  while (($#)); do
    case $1 in
      --source) source_dir=${2:-}; shift 2 ;;
      *) die "unknown register-app argument: $1" ;;
    esac
  done
  [[ -n $source_dir && -d $source_dir ]] || die "missing --source directory"

  local data_home=${XDG_DATA_HOME:-$home/.local/share}
  local bin_dir="$home/.local/bin"
  local app_dir="$data_home/applications"
  local scalable_dir="$data_home/icons/hicolor/scalable/apps"
  local pixmaps_dir="$data_home/pixmaps"

  local launcher_src="$source_dir/scripts/omarchy-cursor-switcher"
  local desktop_src="$source_dir/desktop/omarchy-cursor-switcher.desktop"
  local icon_src="$source_dir/icons/omarchy-cursor-switcher.svg"

  [[ -f $launcher_src ]] || die "launcher script not found: $launcher_src"
  [[ -f $desktop_src ]] || die "desktop entry not found: $desktop_src"
  [[ -f $icon_src ]] || die "icon not found: $icon_src"

  mkdir -p -- "$bin_dir" "$app_dir" "$scalable_dir" "$pixmaps_dir"

  # Install launcher script (atomic)
  local tmp
  tmp=$(mktemp --tmpdir="$bin_dir" .omarchy-cursor-switcher.XXXXXX)
  cp -- "$launcher_src" "$tmp"
  chmod 755 -- "$tmp"
  mv -f -- "$tmp" "$bin_dir/omarchy-cursor-switcher"

  # Install desktop entry (atomic)
  tmp=$(mktemp --tmpdir="$app_dir" .omarchy-cursor-switcher.XXXXXX)
  cp -- "$desktop_src" "$tmp"
  chmod 644 -- "$tmp"
  mv -f -- "$tmp" "$app_dir/omarchy-cursor-switcher.desktop"

  # Install scalable SVG icon (atomic)
  tmp=$(mktemp --tmpdir="$scalable_dir" .omarchy-cursor-switcher.XXXXXX)
  cp -- "$icon_src" "$tmp"
  chmod 644 -- "$tmp"
  mv -f -- "$tmp" "$scalable_dir/omarchy-cursor-switcher.svg"

  # Install pixmaps SVG and PNG copies
  cp -- "$icon_src" "$pixmaps_dir/omarchy-cursor-switcher.svg"

  # Install raster PNG icons if present
  local sz png_src png_dir
  for sz in 48 64 128 256; do
    png_src="$source_dir/icons/omarchy-cursor-switcher-$sz.png"
    if [[ -f $png_src ]]; then
      png_dir="$data_home/icons/hicolor/${sz}x${sz}/apps"
      mkdir -p -- "$png_dir"
      cp -- "$png_src" "$png_dir/omarchy-cursor-switcher.png"
      if [[ $sz == 48 || $sz == 256 ]]; then
        cp -- "$png_src" "$pixmaps_dir/omarchy-cursor-switcher.png"
      fi
    fi
  done

  # Refresh icon cache and desktop database if available (best effort)
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q "$app_dir" 2>/dev/null || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q "$data_home/icons/hicolor" 2>/dev/null || true
  fi
}

install_cleanup_helper() {
  local source_dir="" home=${HOME:?HOME is not set}
  while (($#)); do
    case $1 in
      --source) source_dir=${2:-}; shift 2 ;;
      *) die "unknown install-cleanup-helper argument: $1" ;;
    esac
  done
  [[ -n $source_dir && -d $source_dir ]] || die "missing --source directory"

  local data_home=${XDG_DATA_HOME:-$home/.local/share}
  local target_dir="$data_home/omarchy-cursor-switcher"
  local target_file="$target_dir/omarchy-cursor-switcher-cleanup"
  local src_file="$source_dir/scripts/omarchy-cursor-switcher-cleanup"

  [[ -f $src_file ]] || die "cleanup helper source not found: $src_file"

  mkdir -p -- "$target_dir"
  local tmp
  tmp=$(mktemp --tmpdir="$target_dir" .cleanup.XXXXXX)
  cp -- "$src_file" "$tmp"
  chmod 755 -- "$tmp"
  mv -f -- "$tmp" "$target_file"
}

unregister_app() {
  local script_dir
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  local helper="$script_dir/omarchy-cursor-switcher-cleanup"
  if [[ -f $helper ]]; then
    "$helper" unregister-app "$@"
  fi
}

snapshot_original_state() {
  local script_dir
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  local helper="$script_dir/omarchy-cursor-switcher-cleanup"
  if [[ -f $helper ]]; then
    "$helper" snapshot-original-state "$@"
  fi
}

restore_original_state() {
  local script_dir
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  local helper="$script_dir/omarchy-cursor-switcher-cleanup"
  if [[ -f $helper ]]; then
    "$helper" restore-original-state "$@"
  fi
}

deactivate() {
  local script_dir
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  local helper="$script_dir/omarchy-cursor-switcher-cleanup"
  if [[ -f $helper ]]; then
    "$helper" deactivate "$@"
  fi
}

purge() {
  local script_dir
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  local helper="$script_dir/omarchy-cursor-switcher-cleanup"
  if [[ -f $helper ]]; then
    "$helper" purge "$@"
  fi
}

audit_installation() {
  local script_dir
  script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  local helper="$script_dir/omarchy-cursor-switcher-cleanup"
  if [[ -f $helper ]]; then
    "$helper" audit-installation "$@"
  fi
}

case ${1:-} in
  discover) shift; discover "$@" ;;
  apply) shift; apply_theme "$@" ;;
  ensure-hyprcursor) shift; ensure_hyprcursor "$@" ;;
  import)
    shift
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    if [[ $# -eq 1 && $1 != --* ]]; then
      exec python3 "$script_dir/cursor-import.py" import --source "$1"
    else
      exec python3 "$script_dir/cursor-import.py" import "$@"
    fi
    ;;
  remove-imported)
    shift
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    if [[ $# -eq 1 && $1 != --* ]]; then
      exec python3 "$script_dir/cursor-import.py" remove --id "$1"
    else
      exec python3 "$script_dir/cursor-import.py" remove "$@"
    fi
    ;;
  rename-imported)
    shift
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/cursor-import.py" rename "$@"
    ;;
  choose-file)
    shift
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/choose-file.py" "$@"
    ;;
  list-dir)
    shift
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/file_browser.py" "$@"
    ;;
  get-preview-roles)
    shift
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/cursor_theming.py" get-preview-roles "$@"
    ;;
  get-all-preview-roles)
    shift
    script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
    exec python3 "$script_dir/cursor_theming.py" get-all-preview-roles "$@"
    ;;
  install-cleanup-helper) shift; install_cleanup_helper "$@" ;;
  register-app) shift; register_app "$@" ;;
  unregister-app) shift; unregister_app "$@" ;;
  snapshot-original-state) shift; snapshot_original_state "$@" ;;
  restore-original-state) shift; restore_original_state "$@" ;;
  deactivate) shift; deactivate "$@" ;;
  purge) shift; purge "$@" ;;
  audit-installation) shift; audit_installation "$@" ;;
  *) die "usage: $PROGRAM {discover|apply|ensure-hyprcursor|get-preview-roles|import|remove-imported|rename-imported|choose-file|install-cleanup-helper|register-app|unregister-app|snapshot-original-state|restore-original-state|deactivate|purge|audit-installation} ..." ;;
esac

