#!/usr/bin/env python3
"""
Unified CLI & Dispatcher for Cursor Theme Manager.
Supervises all actions with bounded execution, process-group isolation,
secure descriptor-held state operations, and transactional integration.
"""

import sys
import os
import re
import json
import shutil
import hashlib
import tempfile
import argparse
from pathlib import Path
from typing import List, Dict, Any, Optional

# Add script dir to path
SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from runtime_safety import (
    run_bounded, sanitize_text, emit_bounded_json,
    TIMEOUT_DISCOVERY, TIMEOUT_APPLY, TIMEOUT_CONVERT, TIMEOUT_OPEN_FOLDER,
    TIMEOUT_STATE, LIMIT_STDOUT_DEFAULT, LIMIT_STDOUT_MEDIUM, LIMIT_STDOUT_LARGE,
    LIMIT_STDOUT_SMALL, LIMIT_STDERR_DEFAULT, MAX_DISCOVERED_THEMES,
    MAX_LEN_THEME_ID, MAX_LEN_DISPLAY_NAME, MAX_LEN_PATH, MAX_LEN_SUBTITLE,
    MAX_LEN_LICENSE
)
import secure_state
import cleanup_engine
import cursor_theming
import file_browser

NAME_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._+ -]{0,127}$')


def valid_name(name: str) -> bool:
    if not name or ".." in name:
        return False
    return bool(NAME_RE.match(name))


def read_ini_key(file_path: Path, key: str, max_bytes: int = 32768) -> str:
    """Safely reads a single key from an INI/manifest file without symlink escapes."""
    if not file_path.is_file() or file_path.is_symlink():
        return ""
    try:
        if file_path.stat().st_size > max_bytes:
            return ""
        content = file_path.read_text(encoding="utf-8", errors="ignore")
        pattern = re.compile(rf'^\s*{re.escape(key)}\s*=\s*(.+)$', re.MULTILINE)
        m = pattern.search(content)
        if m:
            val = m.group(1).split("#")[0].split(";")[0].strip()
            val = val.strip("'\"")
            return val
    except Exception:
        pass
    return ""


def has_xcursor(theme_dir: Path) -> bool:
    cursors = theme_dir / "cursors"
    if not cursors.is_dir():
        return False
    for candidate in ("left_ptr", "default", "arrow", "pointer", "top_left_arrow"):
        cand_path = cursors / candidate
        if cand_path.is_file():
            return True
    return False


def has_hyprcursor(theme_dir: Path) -> bool:
    manifest_hl = theme_dir / "manifest.hl"
    manifest_toml = theme_dir / "manifest.toml"
    if not manifest_hl.is_file() and not manifest_toml.is_file():
        return False
    cursors_dir = read_ini_key(manifest_hl, "cursors_directory") or read_ini_key(manifest_toml, "cursors_directory") or "hyprcursors"
    if not valid_name(cursors_dir):
        return False
    return (theme_dir / cursors_dir).is_dir()


def get_preview_path(theme_dir: Path) -> str:
    base = theme_dir.name
    cache_dir = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy-cursor-switcher" / "previews"
    preview_png = cache_dir / f"{base}.png"
    if preview_png.is_file():
        return str(preview_png)

    cursors_dir = theme_dir / "cursors"
    if not cursors_dir.is_dir():
        return ""

    cur_path = None
    for cand in ("left_ptr", "default", "arrow", "pointer", "top_left_arrow"):
        cand_file = cursors_dir / cand
        if cand_file.is_file():
            cur_path = cand_file
            break

    if cur_path and shutil.which("xcur2png"):
        cache_dir.mkdir(parents=True, exist_ok=True)
        temp_dir = Path(tempfile.mkdtemp(prefix=".preview_tmp_"))
        try:
            res = run_bounded(["xcur2png", str(cur_path)], cwd=str(temp_dir), timeout=2.0, stdout_limit=LIMIT_STDOUT_SMALL)
            if res.ok:
                pngs = sorted(temp_dir.glob("*.png"), key=lambda p: p.stat().st_size, reverse=True)
                if pngs:
                    best_png = pngs[0]
                    if shutil.which("magick"):
                        run_bounded(["magick", str(best_png), "-resize", "64x64", str(preview_png)], timeout=2.0)
                    else:
                        shutil.copy2(best_png, preview_png)
                    if preview_png.is_file():
                        return str(preview_png)
        except Exception:
            pass
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)
    return ""


# ==============================================================================
# DISCOVERY
# ==============================================================================

def run_discover():
    home = Path(os.environ.get("HOME", os.path.expanduser("~")))
    data_home = Path(os.environ.get("XDG_DATA_HOME", str(home / ".local" / "share")))
    roots = [data_home / "icons", home / ".icons"]
    sys_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    for d in sys_dirs:
        if d.strip():
            roots.append(Path(d.strip()) / "icons")

    discovered_themes = []
    seen_ids = set()

    for root in roots:
        if not root.is_dir():
            continue
        is_sys_root = (root != data_home / "icons" and root != home / ".icons")

        try:
            entries = list(root.iterdir())
        except OSError:
            continue

        for theme_dir in entries:
            if len(discovered_themes) >= MAX_DISCOVERED_THEMES:
                break
            if not theme_dir.is_dir() or theme_dir.is_symlink():
                continue

            base = theme_dir.name
            if not valid_name(base):
                continue

            # Skip internal generated converted themes
            if base.startswith("CursorSwitcher-XCursor-") or base.startswith("CursorSwitcher-Themed-") or base.startswith("CursorSwitcher-Preview-"):
                continue

            hypr = ""
            xcursor = ""
            formats = []
            display = ""
            is_imported = False
            source_type = "user"
            subtitle = ""

            if has_hyprcursor(theme_dir):
                mname = read_ini_key(theme_dir / "manifest.hl", "name") or read_ini_key(theme_dir / "manifest.toml", "name") or base
                if not valid_name(mname):
                    mname = base
                hypr = mname
                display = hypr
                formats.append("hyprcursor")

            if has_xcursor(theme_dir):
                xcursor = base
                index_name = read_ini_key(theme_dir / "index.theme", "Name") or base
                if valid_name(index_name):
                    display = index_name or display
                else:
                    display = display or base
                formats.append("xcursor")

            if not formats:
                continue

            path_str = sanitize_text(str(theme_dir.resolve()), max_len=MAX_LEN_PATH)
            marker = theme_dir / ".omarchy-cursor-switcher-imported"
            import_license = "Unknown"

            if marker.is_file():
                is_imported = True
                source_type = "imported"
                try:
                    meta = json.loads(marker.read_text(encoding="utf-8"))
                    imp_name = meta.get("displayName", "")
                    imp_lic = meta.get("license", "")
                    if imp_name:
                        display = imp_name
                    if imp_lic:
                        import_license = imp_lic
                except Exception:
                    pass
                subtitle = f"Imported • {import_license}" if import_license and import_license != "Unknown" else "Imported"
            elif is_sys_root:
                source_type = "system"
                idx_comment = read_ini_key(theme_dir / "index.theme", "Comment")
                subtitle = idx_comment if idx_comment else "System"
            else:
                source_type = "user"
                idx_comment = read_ini_key(theme_dir / "index.theme", "Comment")
                subtitle = idx_comment if idx_comment else "User"

            theme_preview = get_preview_path(theme_dir)

            theme_record = {
                "id": sanitize_text(base, max_len=MAX_LEN_THEME_ID),
                "displayName": sanitize_text(display, max_len=MAX_LEN_DISPLAY_NAME),
                "family": sanitize_text(display, max_len=MAX_LEN_DISPLAY_NAME),
                "subtitle": sanitize_text(subtitle, max_len=MAX_LEN_SUBTITLE),
                "hyprcursor": sanitize_text(hypr, max_len=MAX_LEN_THEME_ID),
                "xcursor": sanitize_text(xcursor, max_len=MAX_LEN_THEME_ID),
                "path": path_str,
                "formats": formats,
                "imported": is_imported,
                "sourceType": source_type,
                "license": sanitize_text(import_license, max_len=MAX_LEN_LICENSE),
                "previewPath": sanitize_text(theme_preview, max_len=MAX_LEN_PATH)
            }
            discovered_themes.append(theme_record)

    # Current XCursor from gsettings
    current_xcursor = ""
    res = run_bounded(["gsettings", "get", "org.gnome.desktop.interface", "cursor-theme"], timeout=2.0, stdout_limit=LIMIT_STDOUT_SMALL)
    if res.ok and res.stdout.strip():
        current_xcursor = res.stdout.strip().strip("'\"")

    if current_xcursor == "default":
        def_theme = Path("/usr/share/icons/default/index.theme")
        if def_theme.is_file() and not def_theme.is_symlink():
            inh = read_ini_key(def_theme, "Inherits")
            if valid_name(inh):
                current_xcursor = inh

    emit_bounded_json({
        "themes": discovered_themes,
        "currentXcursor": sanitize_text(current_xcursor, max_len=MAX_LEN_THEME_ID)
    }, max_bytes=LIMIT_STDOUT_LARGE)


# ==============================================================================
# ENSURE HYPRCURSOR (CONVERSION)
# ==============================================================================

def run_ensure_hyprcursor(hypr: str, xcursor: str, theme_path: str = "") -> str:
    home = Path(os.environ.get("HOME", os.path.expanduser("~")))
    data_home = Path(os.environ.get("XDG_DATA_HOME", str(home / ".local" / "share")))
    user_icons = data_home / "icons"

    # 1. Native Hyprcursor check
    if hypr and hypr != "-":
        check_roots = [user_icons, home / ".icons"]
        sys_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
        for d in sys_dirs:
            if d.strip():
                check_roots.append(Path(d.strip()) / "icons")
        for r in check_roots:
            if not r.is_dir():
                continue
            for d in r.iterdir():
                if d.is_dir() and has_hyprcursor(d):
                    mname = read_ini_key(d / "manifest.hl", "name") or read_ini_key(d / "manifest.toml", "name") or d.name
                    if mname == hypr or d.name == hypr:
                        return hypr

    if not xcursor or xcursor == "-":
        sys.stderr.write("cursorctl: no cursor theme specified\n")
        sys.exit(1)

    # 2. Locate XCursor directory
    xdir = None
    if theme_path and (Path(theme_path) / "cursors").is_dir():
        xdir = Path(theme_path)
    else:
        roots = [user_icons, home / ".icons"]
        sys_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
        for d in sys_dirs:
            if d.strip():
                roots.append(Path(d.strip()) / "icons")
        for r in roots:
            cand = r / xcursor
            if (cand / "cursors").is_dir():
                xdir = cand
                break

    if not xdir or not (xdir / "cursors").is_dir():
        sys.stderr.write(f"cursorctl: XCursor directory not found for theme '{xcursor}'\n")
        sys.exit(1)

    # 3. Compute content hash
    hasher = hashlib.sha256()
    for root, _, files in os.walk(xdir):
        for f in sorted(files):
            fp = Path(root) / f
            hasher.update(str(fp.relative_to(xdir)).encode("utf-8"))
            try:
                hasher.update(fp.read_bytes())
            except Exception:
                pass
    hash_short = hasher.hexdigest()[:12]
    converted_name = f"CursorSwitcher-XCursor-{xcursor}-{hash_short}"
    target_dir = user_icons / converted_name

    if (target_dir / "manifest.hl").is_file() and (target_dir / "hyprcursors").is_dir():
        return converted_name

    if not shutil.which("hyprcursor-util"):
        sys.stderr.write(f"cursorctl: hyprcursor-util is required to convert XCursor theme '{xcursor}'\n")
        sys.exit(1)

    temp_dir = Path(tempfile.mkdtemp(prefix=".cs-convert-"))
    clean_source = temp_dir / "clean_source"
    extracted_dir = temp_dir / "extracted"
    created_dir = temp_dir / "created"

    try:
        (clean_source / "cursors").mkdir(parents=True)
        extracted_dir.mkdir(parents=True)
        created_dir.mkdir(parents=True)
        user_icons.mkdir(parents=True, exist_ok=True)

        if (xdir / "index.theme").is_file():
            shutil.copy2(xdir / "index.theme", clean_source / "index.theme")

        for item in (xdir / "cursors").iterdir():
            if item.name.endswith(".cur") or item.name.endswith(".ani"):
                continue
            if item.is_symlink():
                target = os.readlink(item)
                if not target.endswith(".cur") and not target.endswith(".ani"):
                    try:
                        os.symlink(target, clean_source / "cursors" / item.name)
                    except OSError:
                        pass
            elif item.is_file():
                shutil.copy2(item, clean_source / "cursors" / item.name)

        # Run hyprcursor-util extract with run_bounded
        res = run_bounded(
            ["hyprcursor-util", "--extract", str(clean_source), "--output", str(extracted_dir)],
            timeout=TIMEOUT_CONVERT, stdout_limit=LIMIT_STDOUT_MEDIUM, stderr_limit=LIMIT_STDERR_DEFAULT
        )
        if not res.ok:
            sys.stderr.write(f"cursorctl: failed to extract XCursor theme '{xcursor}': {res.stderr}\n")
            sys.exit(1)

        extracted_theme = None
        for d in extracted_dir.iterdir():
            if d.is_dir() and d.name.startswith("extracted_"):
                extracted_theme = d
                break
        if not extracted_theme:
            sys.stderr.write(f"cursorctl: hyprcursor-util extract produced no output for '{xcursor}'\n")
            sys.exit(1)

        manifest_content = (
            f"name = {converted_name}\n"
            f"description = Automatically converted from {xcursor} by Cursor Theme Manager\n"
            f"version = 1.0\n"
            f"cursors_directory = hyprcursors\n"
        )
        (extracted_theme / "manifest.hl").write_text(manifest_content, encoding="utf-8")

        # Run hyprcursor-util create with run_bounded
        res = run_bounded(
            ["hyprcursor-util", "--create", str(extracted_theme), "--output", str(created_dir)],
            timeout=TIMEOUT_CONVERT, stdout_limit=LIMIT_STDOUT_MEDIUM, stderr_limit=LIMIT_STDERR_DEFAULT
        )
        if not res.ok:
            sys.stderr.write(f"cursorctl: failed to create Hyprcursor package for '{xcursor}': {res.stderr}\n")
            sys.exit(1)

        created_theme = None
        for d in created_dir.iterdir():
            if d.is_dir() and d.name.startswith("theme_"):
                created_theme = d
                break
        if not created_theme:
            sys.stderr.write(f"cursorctl: hyprcursor-util create produced no output for '{xcursor}'\n")
            sys.exit(1)

        # Atomic installation into user icons directory
        temp_install = Path(tempfile.mkdtemp(prefix=".convert-", dir=str(user_icons)))
        try:
            shutil.copytree(created_theme, temp_install, dirs_exist_ok=True, symlinks=True)
            (temp_install / ".omarchy-cursor-switcher-converted").write_text("1.0\n", encoding="utf-8")
            if target_dir.exists():
                shutil.rmtree(target_dir, ignore_errors=True)
            os.rename(temp_install, target_dir)
        finally:
            if temp_install.exists():
                shutil.rmtree(temp_install, ignore_errors=True)

        return converted_name
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)


# ==============================================================================
# APPLY THEME
# ==============================================================================

def run_apply(hypr: str, xcursor: str, theme_path: str, size: int, mode: str):
    if size not in secure_state.SUPPORTED_SIZES:
        sys.stderr.write(f"cursorctl: unsupported cursor size: {size}\n")
        sys.exit(1)

    if hypr != "-" and not valid_name(hypr):
        sys.stderr.write("cursorctl: invalid Hyprcursor theme name\n")
        sys.exit(1)
    if xcursor != "-" and not valid_name(xcursor):
        sys.stderr.write("cursorctl: invalid XCursor theme name\n")
        sys.exit(1)

    effective_hypr = run_ensure_hyprcursor(hypr, xcursor, theme_path)

    # 1. hyprctl setcursor
    run_bounded(["hyprctl", "setcursor", effective_hypr, str(size)], timeout=TIMEOUT_APPLY)

    # 2. If commit mode
    if mode == "--commit":
        hypr_env = "" if effective_hypr == "-" else effective_hypr
        run_bounded(["hyprctl", "eval", f'hl.env("HYPRCURSOR_THEME", "{hypr_env}")'], timeout=2.0)
        run_bounded(["hyprctl", "eval", f'hl.env("HYPRCURSOR_SIZE", "{size}")'], timeout=2.0)
        if xcursor != "-":
            run_bounded(["hyprctl", "eval", f'hl.env("XCURSOR_THEME", "{xcursor}")'], timeout=2.0)
            run_bounded(["hyprctl", "eval", f'hl.env("XCURSOR_SIZE", "{size}")'], timeout=2.0)

    # 3. GTK cursor via gsettings
    if xcursor != "-":
        run_bounded(["gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", xcursor], timeout=2.0)
        run_bounded(["gsettings", "set", "org.gnome.desktop.interface", "cursor-size", str(size)], timeout=2.0)

    # 4. Systemd & DBus environment
    assignments = [f"XCURSOR_SIZE={size}", f"HYPRCURSOR_SIZE={size}"]
    if effective_hypr != "-":
        assignments.append(f"HYPRCURSOR_THEME={effective_hypr}")
    if xcursor != "-":
        assignments.append(f"XCURSOR_THEME={xcursor}")

    run_bounded(["systemctl", "--user", "set-environment"] + assignments, timeout=2.0)
    run_bounded(["dbus-update-activation-environment", "--systemd"] + assignments, timeout=2.0)

    # 5. UWSM drop-in files
    if mode == "--commit":
        home = os.environ.get("HOME", os.path.expanduser("~"))
        config_home = os.environ.get("XDG_CONFIG_HOME", os.path.join(home, ".config"))
        common_dir = os.path.join(config_home, "uwsm", "env.d")
        hypr_dir = os.path.join(config_home, "uwsm", "env-hyprland.d")
        os.makedirs(common_dir, exist_ok=True)
        os.makedirs(hypr_dir, exist_ok=True)

        common_file = os.path.join(common_dir, "90-omarchy-cursor-switcher")
        hypr_file = os.path.join(hypr_dir, "90-omarchy-cursor-switcher")

        common_tmp = common_file + f".tmp.{os.getpid()}"
        hypr_tmp = hypr_file + f".tmp.{os.getpid()}"

        with open(common_tmp, "w", encoding="utf-8") as f:
            f.write("# Managed by sanjyay.cursor-theme-manager.\n")
            if xcursor != "-":
                f.write(f"export XCURSOR_THEME='{xcursor}'\n")
            f.write(f"export XCURSOR_SIZE='{size}'\n")

        with open(hypr_tmp, "w", encoding="utf-8") as f:
            f.write("# Managed by sanjyay.cursor-theme-manager.\n")
            if effective_hypr == "-":
                f.write("unset HYPRCURSOR_THEME\n")
            else:
                f.write(f"export HYPRCURSOR_THEME='{effective_hypr}'\n")
            f.write(f"export HYPRCURSOR_SIZE='{size}'\n")

        os.chmod(common_tmp, 0o600)
        os.chmod(hypr_tmp, 0o600)
        os.replace(common_tmp, common_file)
        os.replace(hypr_tmp, hypr_file)


# ==============================================================================
# MAIN ROUTING
# ==============================================================================

def main():
    if len(sys.argv) < 2:
        sys.stderr.write("Usage: cursorctl {discover|apply|ensure-hyprcursor|import|remove-imported|rename-imported|list-dir|choose-file|get-preview-roles|get-all-preview-roles|open-folder|state-read|state-write|integration-status|integration-install|integration-remove|snapshot-original-state|restore-original-state|deactivate|purge|audit-installation} ...\n")
        sys.exit(1)

    cmd = sys.argv[1]

    if cmd == "discover":
        run_discover()

    elif cmd == "ensure-hyprcursor":
        hypr = ""
        xcursor = ""
        theme_path = ""
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--hyprcursor" and i + 1 < len(sys.argv):
                hypr = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--xcursor" and i + 1 < len(sys.argv):
                xcursor = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--theme-path" and i + 1 < len(sys.argv):
                theme_path = sys.argv[i+1]; i += 2
            elif not sys.argv[i].startswith("--"):
                if not hypr: hypr = sys.argv[i]
                elif not xcursor: xcursor = sys.argv[i]
                elif not theme_path: theme_path = sys.argv[i]
                i += 1
            else:
                i += 1
        res = run_ensure_hyprcursor(hypr, xcursor, theme_path)
        sys.stdout.write(res + "\n")
        sys.exit(0)

    elif cmd == "apply":
        hypr = ""
        xcursor = ""
        theme_path = ""
        size = 16
        mode = "--preview"
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--hyprcursor" and i + 1 < len(sys.argv):
                hypr = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--xcursor" and i + 1 < len(sys.argv):
                xcursor = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--theme-path" and i + 1 < len(sys.argv):
                theme_path = sys.argv[i+1]; i += 2
            elif sys.argv[i] == "--size" and i + 1 < len(sys.argv):
                try: size = int(sys.argv[i+1])
                except ValueError: pass
                i += 2
            elif sys.argv[i] in ("--preview", "--commit"):
                mode = sys.argv[i]; i += 1
            else:
                i += 1
        run_apply(hypr, xcursor, theme_path, size, mode)
        sys.exit(0)

    elif cmd == "open-folder":
        path = ""
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--path" and i + 1 < len(sys.argv):
                path = sys.argv[i+1]; i += 2
            elif not sys.argv[i].startswith("--"):
                path = sys.argv[i]; i += 1
            else:
                i += 1
        if path and os.path.isdir(path):
            run_bounded(["xdg-open", path], timeout=TIMEOUT_OPEN_FOLDER)
            emit_bounded_json({"ok": True})
        else:
            emit_bounded_json({"ok": False, "error": "Invalid directory path"}, exit_code=1)

    elif cmd == "state-read":
        st = secure_state.read_state()
        emit_bounded_json(st, max_bytes=LIMIT_STDOUT_SMALL)

    elif cmd == "state-write":
        state_json = ""
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--state" and i + 1 < len(sys.argv):
                state_json = sys.argv[i+1]; i += 2
            else:
                i += 1
        if not state_json and not sys.stdin.isatty():
            state_json = sys.stdin.read(secure_state.MAX_STATE_BYTES + 1)
        try:
            data = json.loads(state_json)
            ok = secure_state.write_state(data)
            emit_bounded_json({"ok": ok})
        except Exception as exc:
            emit_bounded_json({"ok": False, "error": str(exc)}, exit_code=1)

    elif cmd == "integration-status":
        home, _, data_home, _ = cleanup_engine._get_home_dirs()
        desktop_path = os.path.join(data_home, "applications", "omarchy-cursor-switcher.desktop")
        launcher_path = os.path.join(home, ".local", "bin", "omarchy-cursor-switcher")
        cleanup_path = os.path.join(data_home, "omarchy-cursor-switcher", "omarchy-cursor-switcher-cleanup")
        installed = os.path.isfile(desktop_path) and os.path.isfile(launcher_path)
        st = secure_state.read_state()
        emit_bounded_json({
            "ok": True,
            "installed": installed,
            "consent": bool(st.get("integrationConsent", False)),
            "paths": [
                desktop_path,
                launcher_path,
                cleanup_path,
                os.path.join(data_home, "icons", "hicolor", "scalable", "apps", "omarchy-cursor-switcher.svg")
            ]
        })

    elif cmd in ("integration-install", "register-app"):
        source = ""
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--source" and i + 1 < len(sys.argv):
                source = sys.argv[i+1]; i += 2
            elif not sys.argv[i].startswith("--"):
                source = sys.argv[i]; i += 1
            else:
                i += 1
        res = cleanup_engine.install_integration(source)
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)

    elif cmd in ("integration-remove", "unregister-app"):
        res = cleanup_engine.remove_integration()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)

    elif cmd == "install-cleanup-helper":
        # Legacy compat: installs integration helper
        source = ""
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--source" and i + 1 < len(sys.argv):
                source = sys.argv[i+1]; i += 2
            elif not sys.argv[i].startswith("--"):
                source = sys.argv[i]; i += 1
            else:
                i += 1
        home, _, data_home, _ = cleanup_engine._get_home_dirs()
        target_dir = os.path.join(data_home, "omarchy-cursor-switcher")
        src_file = os.path.join(source, "scripts", "omarchy-cursor-switcher-cleanup")
        if os.path.isfile(src_file):
            os.makedirs(target_dir, exist_ok=True)
            for mod_name, mod_mode in [
                ("omarchy-cursor-switcher-cleanup", 0o755),
                ("cleanup_engine.py", 0o644),
                ("runtime_safety.py", 0o644),
                ("secure_state.py", 0o644)
            ]:
                s_path = os.path.join(source, "scripts", mod_name)
                if os.path.isfile(s_path):
                    t_path = os.path.join(target_dir, mod_name)
                    tmp = t_path + f".tmp.{os.getpid()}"
                    shutil.copy2(s_path, tmp)
                    os.chmod(tmp, mod_mode)
                    os.replace(tmp, t_path)
            target_file = os.path.join(target_dir, "omarchy-cursor-switcher-cleanup")
            emit_bounded_json({"ok": True, "installed": target_file})
        else:
            emit_bounded_json({"ok": False, "error": "Cleanup helper source not found"}, exit_code=1)

    elif cmd == "snapshot-original-state":
        res = cleanup_engine.snapshot_original_state()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)

    elif cmd == "restore-original-state":
        res = cleanup_engine.restore_original_state()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)

    elif cmd == "deactivate":
        res = cleanup_engine.deactivate()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)

    elif cmd == "purge":
        res = cleanup_engine.purge()
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)

    elif cmd == "on-destroy":
        pdir = ""
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--plugin-dir" and i + 1 < len(sys.argv):
                pdir = sys.argv[i+1]; i += 2
            elif not sys.argv[i].startswith("--"):
                pdir = sys.argv[i]; i += 1
            else:
                i += 1
        res = cleanup_engine.on_destroy(pdir)
        emit_bounded_json(res, exit_code=0 if res.get("ok") else 1)

    elif cmd == "audit-installation":
        res = cleanup_engine.audit_installation()
        emit_bounded_json(res, exit_code=0)

    # Forwarding to other sub-scripts with sys.argv preservation
    elif cmd == "import":
        import importlib
        cursor_import = importlib.import_module("cursor-import")
        sys.argv = ["cursor-import.py", "import"] + sys.argv[2:]
        cursor_import.main()

    elif cmd == "remove-imported":
        import importlib
        cursor_import = importlib.import_module("cursor-import")
        # Support positional ID or --id
        args = sys.argv[2:]
        if len(args) == 1 and not args[0].startswith("--"):
            args = ["--id", args[0]]
        sys.argv = ["cursor-import.py", "remove"] + args
        cursor_import.main()

    elif cmd == "rename-imported":
        import importlib
        cursor_import = importlib.import_module("cursor-import")
        sys.argv = ["cursor-import.py", "rename"] + sys.argv[2:]
        cursor_import.main()

    elif cmd == "list-dir":
        sys.argv = ["file_browser.py"] + sys.argv[2:]
        file_browser.main()

    elif cmd == "choose-file":
        import importlib
        choose_file = importlib.import_module("choose-file")
        sys.argv = ["choose-file.py"] + sys.argv[2:]
        choose_file.main()

    elif cmd == "get-preview-roles":
        sys.argv = ["cursor_theming.py", "get-preview-roles"] + sys.argv[2:]
        cursor_theming.main()

    elif cmd == "get-all-preview-roles":
        sys.argv = ["cursor_theming.py", "get-all-preview-roles"] + sys.argv[2:]
        cursor_theming.main()

    else:
        sys.stderr.write(f"cursorctl: unknown command '{cmd}'\n")
        sys.exit(1)


if __name__ == "__main__":
    main()
