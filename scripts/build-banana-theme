#!/usr/bin/env python3
"""Build standard Hyprcursor and XCursor packages from upstream Banana SVG sources."""
import json
import os
import shutil
import subprocess
import sys
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
THEME = ROOT / "themes" / "banana"
UPSTREAM = THEME / "upstream" / "svg"
BUILD = THEME / ".build"
GENERATED = THEME / "generated" / "Banana"


def run(*args):
    subprocess.run([str(value) for value in args], check=True)


def require(program, package):
    if shutil.which(program) is None:
        raise SystemExit(f"missing build tool '{program}' (Arch package: {package})")


def normalize_hlc(path):
    """Remove packer timestamps while preserving the standard HLC ZIP format."""
    with zipfile.ZipFile(path, "r") as archive:
        entries = [(name, archive.read(name)) for name in sorted(archive.namelist())]
    temporary = path.with_suffix(".hlc.tmp")
    with zipfile.ZipFile(temporary, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
        for name, payload in entries:
            info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
            info.compress_type = zipfile.ZIP_DEFLATED
            info.create_system = 3
            info.external_attr = 0o100644 << 16
            archive.writestr(info, payload)
    temporary.replace(path)


def main():
    for program, package in [("python3", "python"), ("cc", "gcc"), ("pkg-config", "pkgconf"),
                             ("rsvg-convert", "librsvg"), ("hyprcursor-util", "hyprcursor")]:
        require(program, package)

    spec = json.loads((THEME / "theme.json").read_text(encoding="utf-8"))
    base_canvas = float(spec.get("baseCanvas", 256))

    shutil.rmtree(BUILD, ignore_errors=True)
    shutil.rmtree(GENERATED, ignore_errors=True)
    BUILD.mkdir(parents=True)
    GENERATED.mkdir(parents=True)
    cursors = GENERATED / "cursors"
    cursors.mkdir()

    flags = subprocess.check_output(["pkg-config", "--cflags", "--libs", "xcursor", "libpng"], text=True).split()
    packer = BUILD / "xcursor-pack"
    run("cc", "-O2", "-Wall", "-Wextra", "-Werror", ROOT / "scripts" / "xcursor-pack.c", "-o", packer, *flags)

    # 1. Build XCursors
    for role, data in spec["roles"].items():
        arguments = [packer, cursors / role]
        is_animated = data.get("animated", False)

        if is_animated:
            frames_dir = UPSTREAM / data["source"]
            if not frames_dir.is_dir():
                raise SystemExit(f"missing animated source directory: {frames_dir}")
            frame_files = sorted(frames_dir.glob("*.svg"))
            if not frame_files:
                raise SystemExit(f"no SVG frames found in: {frames_dir}")

            # For each size, render all frames
            for size in spec["sizes"]:
                xhot = round(data["hotspot"][0] * size / base_canvas)
                yhot = round(data["hotspot"][1] * size / base_canvas)
                delay = data.get("delay", 20)
                for i, frame in enumerate(frame_files):
                    png = BUILD / f"{role}-{size}-{i:03d}.png"
                    run("rsvg-convert", "--width", size, "--height", size, "--output", png, frame)
                    arguments.extend([size, xhot, yhot, delay, png])
        else:
            source = UPSTREAM / data["source"]
            if not source.is_file():
                raise SystemExit(f"missing canonical source: {source}")
            for size in spec["sizes"]:
                png = BUILD / f"{role}-{size}.png"
                run("rsvg-convert", "--width", size, "--height", size, "--output", png, source)
                xhot = round(data["hotspot"][0] * size / base_canvas)
                yhot = round(data["hotspot"][1] * size / base_canvas)
                arguments.extend([size, xhot, yhot, 0, png])

        run(*arguments)
        for alias in data["aliases"]:
            alias_path = cursors / alias
            if alias_path.exists() or alias_path.is_symlink():
                continue
            shutil.copy2(cursors / role, alias_path)

    (GENERATED / "index.theme").write_text(
        f"[Icon Theme]\nName={spec['displayName']}\nComment={spec.get('comment', 'The Banana Cursor by ful1e5')}\nInherits=Adwaita\n",
        encoding="utf-8")

    # 2. Build Hyprcursors
    working = BUILD / "hypr-working"
    hypr_shapes = working / "hyprcursors"
    hypr_shapes.mkdir(parents=True)
    (working / "manifest.hl").write_text(
        f"name = {spec['internalName']}\ndescription = {spec.get('comment', 'The Banana Cursor by ful1e5')}\nversion = {spec['version']}\n"
        "cursors_directory = hyprcursors\n", encoding="utf-8")

    for role, data in spec["roles"].items():
        shape = hypr_shapes / role
        shape.mkdir()
        is_animated = data.get("animated", False)

        lines = [
            "resize_algorithm = bilinear",
            f"hotspot_x = {data['hotspot'][0] / base_canvas:.6f}",
            f"hotspot_y = {data['hotspot'][1] / base_canvas:.6f}"
        ]
        lines.extend(f"define_override = {alias}" for alias in data["aliases"])

        if is_animated:
            frames_dir = UPSTREAM / data["source"]
            frame_files = sorted(frames_dir.glob("*.svg"))
            delay = data.get("delay", 20)
            for i, frame in enumerate(frame_files):
                frame_name = f"frame_{i:03d}.svg"
                shutil.copy2(frame, shape / frame_name)
                lines.append(f"define_size = 256, {frame_name}, {delay}")
        else:
            shutil.copy2(UPSTREAM / data["source"], shape / "image.svg")
            lines.append("define_size = 256, image.svg")

        (shape / "meta.hl").write_text("\n".join(lines) + "\n", encoding="utf-8")

    hypr_output = BUILD / "hypr-output"
    hypr_output.mkdir()
    run("hyprcursor-util", "--create", working, "--output", hypr_output)
    candidates = [path for path in hypr_output.iterdir() if path.is_dir() and (path / "manifest.hl").is_file()]
    if len(candidates) != 1:
        raise SystemExit(f"hyprcursor-util produced {len(candidates)} theme directories, expected one")
    for item in candidates[0].iterdir():
        target = GENERATED / item.name
        if target.exists():
            raise SystemExit(f"Hyprcursor output collides with XCursor output: {item.name}")
        shutil.copytree(item, target) if item.is_dir() else shutil.copy2(item, target)
    for archive in sorted((GENERATED / "hyprcursors").glob("*.hlc")):
        normalize_hlc(archive)

    # Package into deterministic bundled archive
    import hashlib, tarfile
    bundled_dir = ROOT / "themes" / "bundled"
    bundled_dir.mkdir(parents=True, exist_ok=True)
    tar_path = bundled_dir / "banana.tar.xz"
    if tar_path.exists():
        tar_path.unlink()

    with tarfile.open(tar_path, "w:xz", preset=6) as tf:
        for root, dirs, files in os.walk(GENERATED):
            dirs.sort()
            files.sort()
            for d in dirs:
                full_d = os.path.join(root, d)
                rel_d = os.path.relpath(full_d, GENERATED)
                arc_d = f"Banana/{rel_d}"
                info = tf.gettarinfo(full_d, arcname=arc_d)
                info.uid = 0
                info.gid = 0
                info.uname = "root"
                info.gname = "root"
                info.mtime = 1700000000
                info.mode = 0o755
                tf.addfile(info)
            for f in files:
                full_f = os.path.join(root, f)
                rel_f = os.path.relpath(full_f, GENERATED)
                arc_f = f"Banana/{rel_f}"
                info = tf.gettarinfo(full_f, arcname=arc_f)
                info.uid = 0
                info.gid = 0
                info.uname = "root"
                info.gname = "root"
                info.mtime = 1700000000
                if os.path.islink(full_f):
                    tf.addfile(info)
                else:
                    info.mode = 0o644
                    with open(full_f, "rb") as fh:
                        tf.addfile(info, fh)

    actual_sha = hashlib.sha256(tar_path.read_bytes()).hexdigest()
    actual_size = tar_path.stat().st_size
    for cat_file in [bundled_dir / "catalog.json", ROOT / "themes" / "catalog.json"]:
        if cat_file.exists():
            cat_data = json.loads(cat_file.read_text(encoding="utf-8"))
            for entry in cat_data:
                if entry["id"] == "banana":
                    entry["sha256"] = actual_sha
                    entry["sizeBytes"] = actual_size
                    entry["archive"] = "themes/bundled/banana.tar.xz"
            cat_file.write_text(json.dumps(cat_data, indent=2) + "\n", encoding="utf-8")

    # Clean up build and generated staging
    shutil.rmtree(BUILD, ignore_errors=True)
    shutil.rmtree(GENERATED.parent, ignore_errors=True)

    print(f"built deterministic bundled archive: {tar_path} (sha256: {actual_sha}, size: {actual_size} bytes)")


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(f"build command failed ({error.returncode}): {' '.join(map(str, error.cmd))}")

